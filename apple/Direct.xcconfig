// The direct download ("Oberton Direct" scheme): the Mac app outside the App Store, signed with Developer ID and
// notarized (scripts/export-direct.sh), not sandboxed, so it can read the text around another app's cursor through
// Accessibility and update itself with Sparkle. The App Store build (the "Oberton" target) is unchanged by this file.
#include "Signing.xcconfig"

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
SUPPORTS_MACCATALYST = NO

ENABLE_APP_SANDBOX = NO
// Notarization requires the hardened runtime.
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = Oberton-Direct.entitlements
// Built and archived with the team's development certificate; the export (method developer-id) re-signs with the
// Developer ID Application certificate. The team comes from Local.xcconfig only.
CODE_SIGN_STYLE = Automatic

// `#if OBERTON_DIRECT` (Distribution.isDirect): Sparkle, and the features the sandbox doesn't allow.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) OBERTON_DIRECT

// Info.plist: the App Store build's keys for the Mac (keep them in step with Info.plist; CI checks) plus Sparkle's.
INFOPLIST_FILE = Info-Direct.plist

// Sparkle (see README.md, "Updates for the direct download").
// The public half of the EdDSA key that signs updates. The private half was made with Sparkle's generate_keys and lives
// only in the release machine's login keychain (account "ed25519"); it is never written to this repository or a file.
OBERTON_SPARKLE_PUBLIC_KEY = RTUbxpcazDZWWR79doEYxiIT5QSd2YnL3krhkknHC7o=
// PLACEHOLDER: the appcast (the list of Mac releases). Nothing is published there yet, so a check finds nothing and
// says "You're up to date". Decide where the Mac feed lives before the first direct release; it must not be the repo's
// "latest" release, which is the Windows one. (`/$()/` keeps `//` from starting a comment.)
OBERTON_APPCAST_URL = https:/$()/github.com/silent-diffusion/dictation/releases/download/mac-appcast/appcast.xml
