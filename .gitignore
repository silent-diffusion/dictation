# local toolchain, runtimes and models (downloaded, never committed)
tools/
runtime/
models/
data/
app/
publish/
dist/
# build output
bin/
obj/
__pycache__/
*.log
*.err
# Claude Code worktrees and local state
.claude/

# Apple (Xcode) build output
apple/build/
apple/ObertonCore/.build/
*.xcuserstate
xcuserdata/
apple/Local.xcconfig
apple/build-direct/

# Never committed: macOS litter, Xcode and SwiftPM state, secrets, signing material, recordings and debug output
# (snapshot PNGs, quirk-check logs). See scripts/privacy-check.sh.
.DS_Store
DerivedData/
.swiftpm/
.env
.env.*
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
*.xcarchive
*.wav
*.m4a
*.jsonl
snapshots/
