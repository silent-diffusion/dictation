<Project>
  <!-- Release builds override Version from the git tag (e.g. v1.2.0 -> 1.2.0). -->
  <PropertyGroup>
    <Version>2.4.0</Version>
    <Product>Oberton</Product>
    <Company>silent-diffusion</Company>
    <Authors>silent-diffusion</Authors>
    <Copyright>Copyright (c) 2026 silent-diffusion</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
