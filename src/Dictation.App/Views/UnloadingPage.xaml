<UserControl x:Class="Dictation.App.Views.UnloadingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Model unloading" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Models take memory while they are loaded (several GB of GPU memory for speech recognition and the AI). Oberton can unload them when you haven't used them for a while."/>

            <TextBlock Text="Unload a model after it has been unused for" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
            <ComboBox x:Name="AfterBox" Width="240" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding UnloadAfterMinutes}" AutomationProperties.Name="Unload after"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                       Text="Applies to the speech recognition model, the local AI model and the Read aloud voice. &quot;Immediately after use&quot; frees them a few seconds after each dictation or reading ends (they stay loaded while in use)."/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="No waiting when you dictate" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Press the hotkey and start talking right away, even if a model was unloaded. Recording starts at once; the speech model loads meanwhile (a few seconds) and then catches up on everything you said. The AI model loads while you speak, too."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Unload now" Style="{StaticResource FieldLabel}" Margin="0,22,0,6"/>
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="Free the memory right away instead of waiting. Each model loads again by itself the next time it's needed."/>
                    <WrapPanel>
                        <Button Content="Unload everything" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Tag="all" Click="Unload_Click"/>
                        <Button Content="Speech model" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Tag="speech" Click="Unload_Click"/>
                        <Button Content="AI model" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Tag="ai" Click="Unload_Click"/>
                        <Button Content="Read aloud voice" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Tag="voice" Click="Unload_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="UnloadResult" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
