<UserControl x:Class="Dictation.App.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="980" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Ob.Mono}" FontSize="30" FontWeight="Bold"
                             BorderThickness="0" Background="Transparent" Padding="0,2" Foreground="{DynamicResource Ob.Text}"
                             ToolTip="Click to rename" AutomationProperties.Name="Profile name"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                             BorderThickness="0" Background="Transparent" Padding="0,2" TextWrapping="Wrap"
                             Foreground="{DynamicResource Ob.Muted}" ToolTip="Description" AutomationProperties.Name="Description"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0">
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource Ob.Strong}" BorderThickness="0" Margin="0,0,8,0"
                            Visibility="{Binding IsActive, Converter={StaticResource B2V}}">
                        <TextBlock Text="ACTIVE" FontSize="11" Foreground="{DynamicResource Ob.OnStrong}"/>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0"
                            Visibility="{Binding IsDefault, Converter={StaticResource B2V}}">
                        <TextBlock Text="DEFAULT" FontSize="11"/>
                    </Border>
                    <Button Content="USE THIS PROFILE" Margin="0,0,8,0" Click="SetActive_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource QuietButton}" Width="36" Padding="0" Click="More_Click"
                            ToolTip="More" AutomationProperties.Name="More profile actions">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource Ob.Text}" Margin="1.5,0"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource Ob.Text}" Margin="1.5,0"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource Ob.Text}" Margin="1.5,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Try it -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <DockPanel Margin="16,10,12,10">
                        <Button x:Name="RunButton" DockPanel.Dock="Right" Content="RUN" Style="{StaticResource PrimaryButton}"
                                MinHeight="32" Click="Run_Click"/>
                        <TextBlock Text="TRY IT" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit the sample, then run this profile on it." FontSize="12" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Ob.Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <!-- The three boxes used everywhere: Transcription · AI Edit (struck through / added) · Inserted -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="16,12,16,16">
                            <TextBlock Text="01 // TRANSCRIPTION" Style="{StaticResource MonoLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TestInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Padding="0"
                                     BorderThickness="0" Background="Transparent" FontFamily="{StaticResource Ob.Mono}" FontSize="13"
                                     Foreground="{DynamicResource Ob.Text}" AutomationProperties.Name="Sample transcript"
                                     Text="um so yesterday I I went to the the store and and bought uh three apples no wait four apples"/>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="1,0,0,0">
                            <StackPanel Margin="16,12,16,16">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TestMeta" DockPanel.Dock="Right" Style="{StaticResource MonoLabel}"/>
                                    <TextBlock Text="02 // AI EDIT" Style="{StaticResource MonoLabel}"/>
                                </DockPanel>
                                <TextBlock x:Name="TestDiff" TextWrapping="Wrap" FontSize="15" LineHeight="23" MinHeight="72"
                                           Foreground="{DynamicResource Ob.Muted}" Text="Run the profile to see what it changes."/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="1,0,0,0">
                            <StackPanel Margin="16,12,16,16">
                                <TextBlock Text="03 // INSERTED" Style="{StaticResource MonoLabel}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TestOutput" TextWrapping="Wrap" FontSize="15" LineHeight="23" MinHeight="72"
                                           Foreground="{DynamicResource Ob.Muted}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- AI on or off: off hides everything that only matters to the AI -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Margin="14,0" Content="Use AI" IsChecked="{Binding AutoProcess}"
                              AutomationProperties.Name="Use AI"/>
                    <TextBlock Margin="14,0,14,12" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Text" Value="Your words go to the local AI model with these instructions before they are inserted."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutoProcess}" Value="False">
                                        <Setter Property="Text" Value="Your words are inserted as the speech recognizer heard them, with the pieces typed while you speak joined into clean sentences. Nothing goes to the AI model."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource Switch}" Margin="14,0" Content="Preview before inserting"
                              IsChecked="{Binding ShowPreview}"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource Switch}" Margin="14,4" IsChecked="{Binding ReadAloudAfterInsert}">
                        <StackPanel>
                            <TextBlock Text="Read aloud after inserting" TextWrapping="Wrap"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Once the text is in place, Read aloud reads it to you with the voice chosen under Models. Press the Read aloud hotkey to stop it."/>
                        </StackPanel>
                    </CheckBox>
                    <!-- Without AI: how the words go into the app while you speak -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutoProcess}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox Style="{StaticResource Switch}" Margin="14,4" IsChecked="{Binding LiveTyping}">
                            <StackPanel>
                                <TextBlock Text="Type the words in, instead of pasting them" TextWrapping="Wrap"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="While you speak, your words go into the app as they are heard. Off (recommended): each new bit is pasted. On: it is typed key by key, which some apps (browsers, chat apps, editors with autocomplete) can garble."/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Every model this profile uses, in one place -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Margin="14,12,14,14">
                    <TextBlock Text="MODELS" Style="{StaticResource FieldLabel}" Margin="0"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,10"
                               Text="What this profile listens, edits and reads with. Only models on this PC are listed (download more under Settings › Models); cloud AI models appear once you add a key and turn off &quot;Keep everything offline&quot;."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="SPEECH TO TEXT" Style="{StaticResource MonoLabel}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SpeechModelBox" Grid.Column="1" Width="528" HorizontalAlignment="Left" DisplayMemberPath="Label"
                                  SelectionChanged="SpeechModelBox_SelectionChanged" AutomationProperties.Name="Speech-to-text model"/>

                        <TextBlock Grid.Row="1" Text="AI EDIT" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding AutoProcess, Converter={StaticResource B2V}}"/>
                        <ComboBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" Width="528" HorizontalAlignment="Left" Margin="0,8,0,0"
                                  DisplayMemberPath="Label" SelectionChanged="ModelBox_SelectionChanged" AutomationProperties.Name="AI model"
                                  Visibility="{Binding AutoProcess, Converter={StaticResource B2V}}"/>

                        <TextBlock Grid.Row="2" Text="READ ALOUD" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox x:Name="TtsModelBox" Width="260" DisplayMemberPath="Label"
                                      SelectionChanged="TtsModelBox_SelectionChanged" AutomationProperties.Name="Read aloud model"/>
                            <ComboBox x:Name="VoiceBox" Width="260" Margin="8,0,0,0" MaxDropDownHeight="420" DisplayMemberPath="Label"
                                      SelectionChanged="VoiceBox_SelectionChanged" AutomationProperties.Name="Read aloud voice"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Switching to a profile with a different speech model loads it; recording starts right away meanwhile. The Read aloud voice also reads this profile's dictations back, and is used by the Read aloud hotkey while this profile is active."/>
                </StackPanel>
            </Border>

            <!-- Instructions and behaviour (AI only) -->
            <Grid Margin="0,24,0,0" Visibility="{Binding AutoProcess, Converter={StaticResource B2V}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="2*" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="INSTRUCTIONS" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="240" MaxHeight="420" VerticalScrollBarVisibility="Auto" Padding="10"
                             AutomationProperties.Name="Instructions"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Sent to the local AI model along with your transcript. It is told to reply with only the edited text."/>

                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Margin="14,0" Content="Rewrite the whole dictation"
                                          IsChecked="{Binding RewriteWhole}" IsEnabled="{Binding AutoProcess}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="14,0,14,12" FontSize="12"
                                           Text="For instructions that reshape what you say, like turning your thoughts into an email. The AI gets everything at once when you stop. While you speak, your words are typed as spoken, then replaced by the rewrite. Off: long dictation is edited a few sentences at a time, which keeps the wording closer to yours."/>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <CheckBox Style="{StaticResource Switch}" Margin="14,0" Content="Keep paragraph breaks"
                                      IsChecked="{Binding PreserveParagraphs}"/>
                            <Border Style="{StaticResource Divider}"/>
                            <CheckBox Style="{StaticResource Switch}" Margin="14,0" Content="Remove filler words"
                                      IsChecked="{Binding RemoveFillers}"/>
                            <Border Style="{StaticResource Divider}"/>
                            <StackPanel Margin="14,12,14,14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Ob.Mono}" FontSize="12"
                                               Text="{Binding MaxChangeRatio, StringFormat='±{0:P0}'}"/>
                                    <TextBlock Text="SAFETY NET" Style="{StaticResource FieldLabel}" Margin="0"/>
                                </DockPanel>
                                <Slider Minimum="0.1" Maximum="0.9" Value="{Binding MaxChangeRatio}" TickFrequency="0.1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,4" AutomationProperties.Name="Safety net">
                                    <Slider.Style>
                                        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RewriteWhole}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                                <TextBlock FontSize="12" Margin="0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Text" Value="If the AI changes the length by more than this, your original words are inserted instead."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RewriteWhole}" Value="True">
                                                    <Setter Property="Text" Value="A rewrite may change the length a lot, so only an empty or runaway result falls back to your original words."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
