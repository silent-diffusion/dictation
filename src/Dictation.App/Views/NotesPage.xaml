<UserControl x:Class="Dictation.App.Views.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <UserControl.Resources>
        <!-- Capsule choices (source, tabs, speed): ink outline, filled when chosen -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ob.Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Ob.Mono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="17" BorderThickness="1" BorderBrush="{DynamicResource Ob.Border}"
                                Background="Transparent" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ob.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ob.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ob.Selected}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ob.Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ob.OnStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The big text boxes: plain, in the text face -->
        <Style x:Key="NotesBox" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,16">

        <!-- ===== Landing: start a session, and the sessions so far ===== -->
        <DockPanel x:Name="Landing">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="EXTENDED NOTES" Style="{StaticResource SectionTitle}" FontSize="30" Margin="0"/>
                    <local:DecorText Text="記録" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ob.Divider}"
                                     VerticalAlignment="Bottom" Margin="12,0,0,1"/>
                </StackPanel>
                <Border Style="{StaticResource Rule}" Margin="0,6,0,6"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Leave it on through a lecture or a meeting. It transcribes as it goes, tidies the text with the AI about every minute, keeps a running summary and the recording, and you can type your own notes straight into the text. Everything stays on this PC."/>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Button x:Name="StartButton" Style="{StaticResource QuietButton}" Click="Start_Click" Margin="0,0,18,6"
                                    AutomationProperties.Name="Start an extended notes session">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StartRing" Width="11" Height="11" StrokeThickness="1.6" Stroke="{DynamicResource Ob.Record}"
                                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="StartText" Text="EXTENDED NOTES SESSION" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="LISTEN TO" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                            <RadioButton x:Name="MicSource" GroupName="Source" Style="{StaticResource Pill}" Content="MIC" Margin="0,0,4,6" Checked="Source_Checked"/>
                            <RadioButton x:Name="ComputerSource" GroupName="Source" Style="{StaticResource Pill}" Content="COMPUTER AUDIO" Margin="0,0,4,6" Checked="Source_Checked"/>
                            <RadioButton x:Name="BothSource" GroupName="Source" Style="{StaticResource Pill}" Content="BOTH" Margin="0,0,4,6" Checked="Source_Checked"/>
                        </WrapPanel>
                        <TextBlock x:Name="StartNote" Style="{StaticResource MonoLabel}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="KEEPS THE RECORDING // ABOUT 115 MB AN HOUR // DICTATING INTO AN APP PAUSES THE SESSION, THEN IT RESUMES"/>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,22,0,8">
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="240" TextChanged="Search_Changed"
                             AutomationProperties.Name="Search the sessions"/>
                    <TextBlock Text="SEARCH" DockPanel.Dock="Right" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="SESSIONS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SessionList"/>
            </ScrollViewer>
        </DockPanel>

        <!-- ===== A session: four plain text views and the recording ===== -->
        <DockPanel x:Name="SessionView" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
                <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="10,3" FontSize="10.5" Margin="0,0,0,8"
                        Content="← EXTENDED NOTES" Click="BackToList_Click"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PauseButton" Style="{StaticResource QuietButton}" Margin="6,0,0,0" Click="Pause_Click"/>
                        <Button x:Name="FullButton" Style="{StaticResource QuietButton}" Margin="6,0,0,0" Content="⤢ FULL SCREEN" Click="Full_Click"/>
                        <Button x:Name="ExportButton" Style="{StaticResource QuietButton}" Margin="6,0,0,0" Content="EXPORT ▾" Click="Export_Click"/>
                        <Button x:Name="StopButton" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Content="■ STOP" Click="Stop_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="RecDot" Width="11" Height="11" StrokeThickness="1.6" Stroke="{DynamicResource Ob.Record}"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid VerticalAlignment="Center">
                            <Button x:Name="TitleButton" Click="Title_Click" Cursor="IBeam" Background="Transparent" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Ob.Divider}" Padding="0,1" ToolTip="Click to rename"
                                    AutomationProperties.Name="Session name; click to rename">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="TitleText" FontFamily="{StaticResource Ob.Mono}" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource Ob.Text}" TextTrimming="CharacterEllipsis"/>
                            </Button>
                            <TextBox x:Name="TitleBox" Visibility="Collapsed" FontFamily="{StaticResource Ob.Mono}" FontSize="22" FontWeight="Bold"
                                     MinWidth="360" LostKeyboardFocus="TitleBox_LostFocus" KeyDown="TitleBox_KeyDown"
                                     AutomationProperties.Name="Session name"/>
                        </Grid>
                        <TextBlock x:Name="TimerText" FontFamily="{StaticResource Ob.Mono}" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Rule}" Margin="0,10,0,10"/>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="TabHint" DockPanel.Dock="Right" Style="{StaticResource MonoLabel}" FontSize="10" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TranscriptTab" GroupName="Tab" Style="{StaticResource Pill}" Content="TRANSCRIPT" Checked="Tab_Checked"/>
                        <RadioButton x:Name="FormattedTab" GroupName="Tab" Style="{StaticResource Pill}" Content="FORMATTED" Checked="Tab_Checked"/>
                        <RadioButton x:Name="SummaryTab" GroupName="Tab" Style="{StaticResource Pill}" Content="SUMMARY" Checked="Tab_Checked"/>
                        <RadioButton x:Name="EditedTab" GroupName="Tab" Style="{StaticResource Pill}" Content="EDITED" Checked="Tab_Checked"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- The recording: plays from where the cursor is in the text -->
            <Border DockPanel.Dock="Bottom" BorderThickness="1" BorderBrush="{DynamicResource Ob.Divider}" Padding="12,8" Margin="0,10,0,0">
                <DockPanel>
                    <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Width="36" Height="36" Padding="0"
                            Click="Play_Click" ToolTip="Play from the cursor" AutomationProperties.Name="Play the recording from the cursor">
                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <TextBlock x:Name="PlayTime" DockPanel.Dock="Left" FontFamily="{StaticResource Ob.Mono}" FontSize="11.5" VerticalAlignment="Center"
                               Margin="12,0,12,0" MinWidth="130"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <RadioButton x:Name="Speed1" GroupName="Speed" Style="{StaticResource Pill}" Content="1×" IsChecked="True" Padding="0" Checked="Speed_Checked"/>
                        <RadioButton x:Name="Speed15" GroupName="Speed" Style="{StaticResource Pill}" Content="1.5×" Checked="Speed_Checked"/>
                        <RadioButton x:Name="Speed2" GroupName="Speed" Style="{StaticResource Pill}" Content="2×" Checked="Speed_Checked"/>
                    </StackPanel>
                    <Slider x:Name="Seek" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="Seek_ValueChanged"
                            AutomationProperties.Name="Position in the recording"/>
                </DockPanel>
            </Border>

            <Grid>
                <TextBox x:Name="TranscriptBox" Style="{StaticResource NotesBox}" AutomationProperties.Name="Transcript"/>
                <TextBox x:Name="FormattedBox" Style="{StaticResource NotesBox}" Visibility="Collapsed" AutomationProperties.Name="Formatted"/>
                <TextBox x:Name="SummaryBox" Style="{StaticResource NotesBox}" Visibility="Collapsed" AutomationProperties.Name="Summary"/>
                <DockPanel x:Name="EditedPanel" Visibility="Collapsed">
                    <WrapPanel x:Name="Legend" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
                    <RichTextBox x:Name="EditedBox" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto"
                                 FontSize="14.5" Padding="10,8" AutomationProperties.Name="Edited: every change, in colour"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
