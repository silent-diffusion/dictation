<UserControl x:Class="Dictation.App.Views.ReadAloudPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Read aloud" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="Intro" Style="{StaticResource Caption}"/>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <DockPanel Margin="18,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="InstallButton" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="Install_Click"/>
                        <Button x:Name="TryButton" Content="Try it" Style="{StaticResource PrimaryButton}" Click="Try_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="StatusText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <ProgressBar x:Name="InstallBar" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Voice" Style="{StaticResource FieldLabel}" Margin="0,24,0,6"/>
            <ComboBox x:Name="VoiceBox" Width="300" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding TtsVoice}" AutomationProperties.Name="Voice"/>

            <TextBlock Text="Base speed" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SpeedSlider" Width="300" Minimum="0.5" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Value="{Binding TtsBaseSpeed}" AutomationProperties.Name="Base speed"/>
                <TextBlock Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:0.00}×}" Width="60" Margin="12,0,0,0"
                           FontFamily="{StaticResource Ob.Mono}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Every reading starts at this speed. The − and + buttons in the reader change it for that reading only."/>

            <TextBlock Text="How to use it" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
            <TextBlock x:Name="HowTo" Style="{StaticResource Caption}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
