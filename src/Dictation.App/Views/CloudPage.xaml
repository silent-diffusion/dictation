<UserControl x:Class="Dictation.App.Views.CloudPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <local:PageHeader Title="Cloud AI" Decor="設定" Readout="SECTION B.3"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Oberton's own models run on this PC. Optionally, a profile can use a cloud model instead (Anthropic's Claude, or OpenAI and compatible services) for stronger rewriting. Only the text of a dictation is sent, never the audio, and only for profiles you set to a cloud model."/>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <CheckBox x:Name="OfflineSwitch" Style="{StaticResource Switch}" IsChecked="{Binding Cloud.KeepOffline}" Margin="18,4"
                          Click="Offline_Click">
                    <StackPanel>
                        <TextBlock Text="Keep everything offline" FontWeight="SemiBold"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="While this is on, nothing is ever sent to a cloud model, whatever a profile selects: such a profile inserts your words as spoken and says why."/>
                    </StackPanel>
                </CheckBox>
            </Border>

            <!-- Anthropic -->
            <TextBlock Text="ANTHROPIC (CLAUDE)" Style="{StaticResource FieldLabel}" Margin="0,26,0,6"/>
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="API key" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="REMOVE" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                                Click="RemoveAnthropic_Click"/>
                        <Button DockPanel.Dock="Right" Content="SAVE KEY" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Click="SaveAnthropic_Click"/>
                        <PasswordBox x:Name="AnthropicKey" Padding="6,5" AutomationProperties.Name="Anthropic API key"/>
                    </DockPanel>
                    <TextBlock x:Name="AnthropicStatus" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- OpenAI-compatible -->
            <TextBlock Text="OPENAI OR A COMPATIBLE SERVICE" Style="{StaticResource FieldLabel}" Margin="0,22,0,6"/>
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="API key" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="REMOVE" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                                Click="RemoveOpenAi_Click"/>
                        <Button DockPanel.Dock="Right" Content="SAVE KEY" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Click="SaveOpenAi_Click"/>
                        <PasswordBox x:Name="OpenAiKey" Padding="6,5" AutomationProperties.Name="OpenAI API key"/>
                    </DockPanel>
                    <TextBlock x:Name="OpenAiStatus" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                    <TextBlock Text="Model" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding Cloud.OpenAiModel, UpdateSourceTrigger=LostFocus}" Width="280" HorizontalAlignment="Left"
                             AutomationProperties.Name="OpenAI model"/>
                    <TextBlock Text="Service address" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding Cloud.OpenAiBaseUrl, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Service address"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="https://api.openai.com/v1 for OpenAI. Services with the same API (OpenRouter, Groq and others) work too."/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0"
                       Text="Keys are encrypted for your Windows account and stored only on this PC. To use a cloud model, pick it on a profile's page or under Settings › Models; cloud models are marked CLOUD there."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
