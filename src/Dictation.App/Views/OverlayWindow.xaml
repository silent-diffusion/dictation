<Window x:Class="Dictation.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="Height" Width="600"
        ThemeMode="None" Title="Dictation overlay">
    <Border Margin="14" CornerRadius="16" Background="#F2202026" Padding="18,12,18,14"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FF5A5A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ProfileText" Grid.Column="2" Foreground="#B0FFFFFF" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,8,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="RawButton" Content="Insert original" Visibility="Collapsed"
                            Padding="8,2" Margin="0,0,6,0" FontSize="11" Click="Raw_Click" Focusable="False"/>
                    <Button x:Name="CancelButton" Content="✕" Width="26" Height="26" Padding="0"
                            Click="Cancel_Click" Focusable="False" ToolTip="Cancel" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="TranscriptText" Foreground="White" FontSize="16" TextWrapping="Wrap"
                       MaxHeight="96" Margin="0,8,0,0" LineHeight="22"/>
            <ProgressBar x:Name="Level" Height="4" Minimum="0" Maximum="1" Margin="0,10,0,0" Foreground="#6FD16F"
                         Background="#22FFFFFF" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>
