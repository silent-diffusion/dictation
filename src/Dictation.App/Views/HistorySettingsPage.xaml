<UserControl x:Class="Dictation.App.Views.HistorySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <local:PageHeader Title="History" Decor="設定" Readout="SECTION A.4"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Recent dictations are kept on this PC with everything about them: the recording, the transcription, the AI's output and what was inserted where. They are stored in Oberton's data folder, which app updates never touch."/>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel Margin="18,0">
                    <CheckBox Style="{StaticResource Switch}" Content="Keep a history of dictations" IsChecked="{Binding KeepHistory}"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SaveHistoryAudio}" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="Keep the recordings" TextWrapping="Wrap"/>
                            <TextBlock Text="So you can play a dictation back. About 2 MB per minute of speech."
                                       FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <TextBlock Text="HOW LONG TO KEEP" Style="{StaticResource FieldLabel}" Margin="0,22,0,6"/>
            <Border Style="{StaticResource Card}">
                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Text" TextWrapping="Wrap"/>
                        <TextBlock Text="The dictation itself: what was heard, the AI's edit, and where it went." FontSize="12"
                                   Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="TextKeepBox" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="How long to keep the text of dictations"/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Divider}"/>
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Recordings" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AudioKeepNote" FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="The audio, for playing a dictation back. Never kept longer than its text."/>
                    </StackPanel>
                    <ComboBox x:Name="AudioKeepBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                              IsEnabled="{Binding SaveHistoryAudio}" AutomationProperties.Name="How long to keep the recordings of dictations"/>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Keep a number of the newest, or everything from a recent stretch of time. Older ones are deleted as new ones come in, every hour, and right away when you choose less. A recording deleted this way leaves its dictation's text in History."/>

            <TextBlock Text="STORED IN" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
            <TextBlock x:Name="FolderText" FontFamily="{StaticResource Ob.Mono}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="SizeText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="OPEN FOLDER" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="Open_Click"/>
                <Button Content="DELETE ALL HISTORY…" Style="{StaticResource QuietButton}" Click="Clear_Click"/>
            </StackPanel>

            <TextBlock Text="ANALYTICS WORD TALLY" Style="{StaticResource FieldLabel}" Margin="0,24,0,6"/>
            <Border Style="{StaticResource Card}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepWordTally}" Margin="18,4">
                    <StackPanel>
                        <TextBlock Text="Count the words I dictate, for Analytics" TextWrapping="Wrap"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="After each dictation: the words and phrases that went in, the words the AI corrected and the fillers it took out, the hour, and how much the profile changed. Counts only, never sentences, kept in words.json next to History."/>
                    </StackPanel>
                </CheckBox>
            </Border>
            <Button Content="RESET WORD TALLY…" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="ResetWords_Click"/>

            <TextBlock Text="DASHBOARD COUNTS" Style="{StaticResource FieldLabel}" Margin="0,24,0,6"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="The dashboard keeps its own daily tallies in usage.json next to History: per day, how many dictations and words, seconds spoken, the turnaround, AI edits kept, texts read aloud, and dictations per app (the app's name only; in a browser, also the site's name, such as Gmail). Never any text, audio or window titles. They stay when you delete History or turn it off."/>
            <Button Content="RESET DASHBOARD COUNTS…" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="ResetUsage_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
