<UserControl x:Class="Dictation.App.Views.HistorySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <local:PageHeader Title="History" Decor="設定" Readout="SECTION A.4"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Recent dictations are kept on this PC with everything about them: the recording, the transcription, the AI's output and what was inserted where. They are stored in Oberton's data folder, which app updates never touch."/>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel Margin="18,0">
                    <CheckBox Style="{StaticResource Switch}" Content="Keep a history of dictations" IsChecked="{Binding KeepHistory}"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SaveHistoryAudio}" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="Keep the recordings" TextWrapping="Wrap"/>
                            <TextBlock Text="So you can play a dictation back. About 2 MB per minute of speech."
                                       FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <TextBlock Text="HOW MANY TO KEEP" Style="{StaticResource FieldLabel}" Margin="0,22,0,6"/>
            <ComboBox x:Name="LimitBox" Width="200" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding HistoryLimit}" AutomationProperties.Name="How many dictations to keep"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="The oldest ones are deleted as new ones come in (also right away when you lower this). With &quot;All of them&quot;, nothing is deleted unless you delete it."/>

            <TextBlock Text="STORED IN" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
            <TextBlock x:Name="FolderText" FontFamily="{StaticResource Ob.Mono}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="SizeText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="OPEN FOLDER" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="Open_Click"/>
                <Button Content="DELETE ALL HISTORY…" Style="{StaticResource QuietButton}" Click="Clear_Click"/>
            </StackPanel>

            <TextBlock Text="DASHBOARD COUNTS" Style="{StaticResource FieldLabel}" Margin="0,24,0,6"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="The dashboard keeps its own daily tallies in usage.json next to History: per day, how many dictations and words, seconds spoken, the turnaround, AI edits kept, texts read aloud, and dictations per app (the app's name only). Never any text, audio or window titles. They stay when you delete History or turn it off."/>
            <Button Content="RESET DASHBOARD COUNTS…" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="ResetUsage_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
