<UserControl x:Class="Dictation.App.Views.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A tiny drawing of a window in one theme, for the theme cards. Colors are fixed on purpose. -->
        <Style x:Key="PreviewFrame" TargetType="Border">
            <Setter Property="Height" Value="84"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33808080"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Caption}" Text="Follows Windows by default. Pick Light or Dark to override it."/>

            <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
            <UniformGrid Columns="3" AutomationProperties.Name="Theme">
                <RadioButton x:Name="SystemRadio" GroupName="Theme" Style="{StaticResource ChoiceCard}" Margin="0,0,8,0"
                             Checked="Theme_Checked" AutomationProperties.Name="System">
                    <StackPanel>
                        <Border Style="{StaticResource PreviewFrame}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Background="#F7F6F3">
                                    <Border Width="18" HorizontalAlignment="Left" Background="#EFEDE8"/>
                                    <Border Height="6" Width="40" CornerRadius="3" Background="#1A1A1A" Margin="26,14,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Grid>
                                <Grid Grid.Column="1" Background="#18181A">
                                    <Border Height="6" Width="40" CornerRadius="3" Background="#EDEBE7" Margin="10,14,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock Text="System" Margin="4,10,0,2" FontSize="14"/>
                        <TextBlock x:Name="SystemHint" Margin="4,0,0,2" FontSize="12" Foreground="{DynamicResource Ob.Muted}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LightRadio" GroupName="Theme" Style="{StaticResource ChoiceCard}" Margin="4,0"
                             Checked="Theme_Checked" AutomationProperties.Name="Light">
                    <StackPanel>
                        <Border Style="{StaticResource PreviewFrame}" Background="#F7F6F3">
                            <Grid>
                                <Border Width="36" HorizontalAlignment="Left" Background="#EFEDE8"/>
                                <StackPanel Margin="46,14,12,0">
                                    <Border Height="6" Width="56" CornerRadius="3" Background="#1A1A1A" HorizontalAlignment="Left"/>
                                    <Border Height="4" CornerRadius="2" Background="#CFCAC0" Margin="0,8,0,0"/>
                                    <Border Height="4" CornerRadius="2" Background="#CFCAC0" Margin="0,6,20,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Light" Margin="4,10,0,2" FontSize="14"/>
                        <TextBlock Text=" " Margin="4,0,0,2" FontSize="12"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DarkRadio" GroupName="Theme" Style="{StaticResource ChoiceCard}" Margin="8,0,0,0"
                             Checked="Theme_Checked" AutomationProperties.Name="Dark">
                    <StackPanel>
                        <Border Style="{StaticResource PreviewFrame}" Background="#18181A">
                            <Grid>
                                <Border Width="36" HorizontalAlignment="Left" Background="#121214"/>
                                <StackPanel Margin="46,14,12,0">
                                    <Border Height="6" Width="56" CornerRadius="3" Background="#EDEBE7" HorizontalAlignment="Left"/>
                                    <Border Height="4" CornerRadius="2" Background="#46464D" Margin="0,8,0,0"/>
                                    <Border Height="4" CornerRadius="2" Background="#46464D" Margin="0,6,20,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Dark" Margin="4,10,0,2" FontSize="14"/>
                        <TextBlock Text=" " Margin="4,0,0,2" FontSize="12"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="Overlay" Style="{StaticResource FieldLabel}" Margin="0,28,0,6"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="18,6,18,16">
                        <CheckBox Style="{StaticResource Switch}" Content="Show the overlay while dictating"
                                  IsChecked="{Binding ShowOverlay}"/>
                        <Border Style="{StaticResource Divider}" Margin="0,2,0,12"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Ob.Mono}" FontSize="12"
                                       Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}"/>
                            <TextBlock Text="Opacity"/>
                        </DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0.6" Maximum="1" Value="{Binding OverlayOpacity}"
                                TickFrequency="0.02" IsSnapToTickEnabled="True" Margin="0,6,0,10"
                                AutomationProperties.Name="Overlay opacity"/>
                        <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0"
                                   Text="The overlay sits at the bottom center of the screen. It stays dark in both themes so it reads on top of any window. The preview approval always shows, even with the overlay off."/>
                    </StackPanel>

                    <!-- Live preview of the pill over some placeholder text -->
                    <Border Grid.Column="1" Background="{DynamicResource Ob.Subtle}" CornerRadius="0,11,11,0" MinHeight="200"
                            ClipToBounds="True">
                        <Grid>
                            <StackPanel Margin="20,22,20,0" VerticalAlignment="Top">
                                <Border Height="7" Width="120" CornerRadius="3" Background="{DynamicResource Ob.Muted}" HorizontalAlignment="Left"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,12,0,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,30,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,10,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,50,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,20,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Height="40"
                                    CornerRadius="20" Padding="16,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="#161618" Opacity="{Binding Value, ElementName=OpacitySlider}"/>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#E5533A" VerticalAlignment="Center"/>
                                    <TextBlock Text="0:07" Foreground="White" FontFamily="{StaticResource Ob.Mono}" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewProfile" Foreground="#B8FFFFFF" FontSize="12" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
