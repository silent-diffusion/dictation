<UserControl x:Class="Dictation.App.Views.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <UserControl.Resources>
        <!-- A tiny drawing of a window in one theme, for the theme cards. Colors are fixed on purpose. -->
        <Style x:Key="PreviewFrame" TargetType="Border">
            <Setter Property="Height" Value="84"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#55808080"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="820" HorizontalAlignment="Left">
            <local:PageHeader Title="Appearance" Decor="設定" Readout="SECTION C.1"/>
            <TextBlock Style="{StaticResource Caption}" Text="Follows Windows by default. Pick Light or Dark to override it."/>

            <TextBlock Text="THEME" Style="{StaticResource FieldLabel}"/>
            <UniformGrid Columns="3" AutomationProperties.Name="Theme">
                <RadioButton x:Name="SystemRadio" GroupName="Theme" Style="{StaticResource ChoiceCard}" Margin="0,0,8,0"
                             Checked="Theme_Checked" AutomationProperties.Name="System">
                    <StackPanel>
                        <Border Style="{StaticResource PreviewFrame}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Background="#E8E7E3">
                                    <Border Width="18" HorizontalAlignment="Left" BorderBrush="#0D0D0C" BorderThickness="0,0,1,0"/>
                                    <Border Height="6" Width="40" Background="#0D0D0C" Margin="26,14,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Grid>
                                <Grid Grid.Column="1" Background="#0E0E0D">
                                    <Border Height="6" Width="40" Background="#E8E7E3" Margin="10,14,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock Text="SYSTEM" Margin="4,10,0,2" FontFamily="{StaticResource Ob.Mono}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="SystemHint" Margin="4,0,0,2" Style="{StaticResource MonoLabel}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LightRadio" GroupName="Theme" Style="{StaticResource ChoiceCard}" Margin="4,0"
                             Checked="Theme_Checked" AutomationProperties.Name="Light">
                    <StackPanel>
                        <Border Style="{StaticResource PreviewFrame}" Background="#E8E7E3">
                            <Grid>
                                <Border Width="36" HorizontalAlignment="Left" BorderBrush="#0D0D0C" BorderThickness="0,0,1,0"/>
                                <StackPanel Margin="46,14,12,0">
                                    <Border Height="6" Width="56" Background="#0D0D0C" HorizontalAlignment="Left"/>
                                    <Border Height="1" Background="#0D0D0C" Margin="0,6,0,0"/>
                                    <Border Height="4" Background="#5C5B57" Margin="0,8,0,0"/>
                                    <Border Height="4" Background="#5C5B57" Margin="0,6,20,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="LIGHT" Margin="4,10,0,2" FontFamily="{StaticResource Ob.Mono}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text=" " Margin="4,0,0,2" FontSize="12"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DarkRadio" GroupName="Theme" Style="{StaticResource ChoiceCard}" Margin="8,0,0,0"
                             Checked="Theme_Checked" AutomationProperties.Name="Dark">
                    <StackPanel>
                        <Border Style="{StaticResource PreviewFrame}" Background="#0E0E0D">
                            <Grid>
                                <Border Width="36" HorizontalAlignment="Left" BorderBrush="#E8E7E3" BorderThickness="0,0,1,0"/>
                                <StackPanel Margin="46,14,12,0">
                                    <Border Height="6" Width="56" Background="#E8E7E3" HorizontalAlignment="Left"/>
                                    <Border Height="1" Background="#E8E7E3" Margin="0,6,0,0"/>
                                    <Border Height="4" Background="#8F8D87" Margin="0,8,0,0"/>
                                    <Border Height="4" Background="#8F8D87" Margin="0,6,20,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="DARK" Margin="4,10,0,2" FontFamily="{StaticResource Ob.Mono}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text=" " Margin="4,0,0,2" FontSize="12"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="ACCENT" Style="{StaticResource FieldLabel}" Margin="0,28,0,6"/>
            <UniformGrid x:Name="SchemeGrid" Columns="5" AutomationProperties.Name="Accent color"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Oberton is ink on paper. The accent marks what is live or matters most right now: today's word count, the unload countdown, the word being read, words the AI added, and errors. Each accent has a version for light and for dark paper. Red is not offered: it means the microphone is recording."/>

            <TextBlock Text="DICTATION OVERLAY" Style="{StaticResource FieldLabel}" Margin="0,28,0,6"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="18,6,18,16">
                        <CheckBox Style="{StaticResource Switch}" Content="Show the overlay while dictating"
                                  IsChecked="{Binding ShowOverlay}"/>
                        <Border Style="{StaticResource Divider}" Margin="0,2,0,12"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Ob.Mono}" FontSize="12"
                                       Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}"/>
                            <TextBlock Text="Opacity"/>
                        </DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" Value="{Binding OverlayOpacity}"
                                TickFrequency="0.02" IsSnapToTickEnabled="True" Margin="0,6,0,10"
                                AutomationProperties.Name="Overlay opacity"/>
                        <Border Style="{StaticResource Divider}" Margin="0,2,0,12"/>
                        <DockPanel>
                            <TextBlock x:Name="PositionName" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Ob.Muted}"/>
                            <TextBlock Text="Position"/>
                        </DockPanel>
                        <!-- A miniature screen; click where the overlay should sit -->
                        <Border Width="220" Height="124" Margin="0,8,0,12" HorizontalAlignment="Left" CornerRadius="2"
                                BorderThickness="1" BorderBrush="{DynamicResource Ob.Border}" Background="{DynamicResource Ob.Window}">
                            <UniformGrid x:Name="PositionGrid" Rows="3" Columns="3" Margin="4" AutomationProperties.Name="Overlay position">
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="TopLeft" ToolTip="Top left"
                                             AutomationProperties.Name="Top left" Checked="Position_Checked"/>
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="TopCenter" ToolTip="Top center"
                                             AutomationProperties.Name="Top center" Checked="Position_Checked"/>
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="TopRight" ToolTip="Top right"
                                             AutomationProperties.Name="Top right" Checked="Position_Checked"/>
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="MiddleLeft" ToolTip="Middle left"
                                             AutomationProperties.Name="Middle left" Checked="Position_Checked"/>
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="Center" ToolTip="Center"
                                             AutomationProperties.Name="Center" Checked="Position_Checked"/>
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="MiddleRight" ToolTip="Middle right"
                                             AutomationProperties.Name="Middle right" Checked="Position_Checked"/>
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="BottomLeft" ToolTip="Bottom left"
                                             AutomationProperties.Name="Bottom left" Checked="Position_Checked"/>
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="BottomCenter" ToolTip="Bottom center"
                                             AutomationProperties.Name="Bottom center" Checked="Position_Checked"/>
                                <RadioButton GroupName="Position" Style="{StaticResource PositionCell}" Tag="BottomRight" ToolTip="Bottom right"
                                             AutomationProperties.Name="Bottom right" Checked="Position_Checked"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0"
                                   Text="The overlay stays dark in both themes so it reads on top of any window. The preview approval always shows, even with the overlay off."/>
                    </StackPanel>

                    <!-- Live preview of the pill over some placeholder text -->
                    <Border Grid.Column="1" Background="{DynamicResource Ob.Subtle}" MinHeight="200"
                            ClipToBounds="True">
                        <Grid>
                            <StackPanel Margin="20,22,20,0" VerticalAlignment="Top">
                                <Border Height="7" Width="120" CornerRadius="3" Background="{DynamicResource Ob.Muted}" HorizontalAlignment="Left"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,12,0,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,30,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,10,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,50,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,20,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Height="40"
                                    CornerRadius="20" Padding="16,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="#0D0D0C" Opacity="{Binding Value, ElementName=OpacitySlider}"/>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#FF4636" VerticalAlignment="Center"/>
                                    <TextBlock Text="0:07" Foreground="#E8E7E3" FontFamily="{StaticResource Ob.Mono}" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewProfile" Foreground="#B8E8E7E3" FontFamily="{StaticResource Ob.Mono}" FontSize="11" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="READ ALOUD PLAYER" Style="{StaticResource FieldLabel}" Margin="0,28,0,6"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="18,6,18,16">
                        <CheckBox x:Name="SamePlaceBox" Style="{StaticResource Switch}" Content="Same place as the dictation overlay"
                                  Checked="SamePlace_Changed" Unchecked="SamePlace_Changed"/>
                        <Border Style="{StaticResource Divider}" Margin="0,2,0,12"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Ob.Mono}" FontSize="12"
                                       Text="{Binding Value, ElementName=ReaderOpacitySlider, StringFormat={}{0:P0}}"/>
                            <TextBlock Text="Opacity"/>
                        </DockPanel>
                        <Slider x:Name="ReaderOpacitySlider" Minimum="0.3" Maximum="1" Value="{Binding ReaderOpacity}"
                                TickFrequency="0.02" IsSnapToTickEnabled="True" Margin="0,6,0,10"
                                AutomationProperties.Name="Read aloud player opacity"/>
                        <Border Style="{StaticResource Divider}" Margin="0,2,0,12"/>
                        <DockPanel>
                            <TextBlock x:Name="ReaderPositionName" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Ob.Muted}"/>
                            <TextBlock Text="Position"/>
                        </DockPanel>
                        <!-- A miniature screen; click where the player should sit -->
                        <Border x:Name="ReaderPositionPanel" Width="220" Height="124" Margin="0,8,0,12" HorizontalAlignment="Left" CornerRadius="2"
                                BorderThickness="1" BorderBrush="{DynamicResource Ob.Border}" Background="{DynamicResource Ob.Window}">
                            <UniformGrid x:Name="ReaderPositionGrid" Rows="3" Columns="3" Margin="4" AutomationProperties.Name="Read aloud player position"/>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0"
                                   Text="The player that reads text aloud. Like the dictation overlay it stays dark in both themes, and you can drag it while it reads."/>
                    </StackPanel>

                    <!-- Live preview of the player over some placeholder text -->
                    <Border Grid.Column="1" Background="{DynamicResource Ob.Subtle}" MinHeight="200"
                            ClipToBounds="True">
                        <Grid>
                            <StackPanel Margin="20,22,20,0" VerticalAlignment="Top">
                                <Border Height="7" Width="120" CornerRadius="3" Background="{DynamicResource Ob.Muted}" HorizontalAlignment="Left"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,12,0,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,30,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,10,0"/>
                                <Border Height="5" CornerRadius="2" Background="{DynamicResource Ob.Track}" Margin="0,8,50,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,18" CornerRadius="16"
                                    Padding="14,10" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="#0D0D0C" Opacity="{Binding Value, ElementName=ReaderOpacitySlider}"/>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Foreground="#73E8E7E3" FontSize="12" TextWrapping="Wrap" MaxWidth="220">
                                        <Run Text="Select any text and press the shortcut " Foreground="#E8E7E3"/><Run Text="to" Foreground="{DynamicResource Ob.AccentOnDark}"/><Run Text=" hear it read aloud."/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#E8E7E3">
                                            <Path Data="M 8,6 L 16,11 L 8,16 Z" Fill="#0D0D0C"/>
                                        </Border>
                                        <Border Height="1" Width="120" Background="#38E8E7E3" Margin="10,0,0,0"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="1.0×" Foreground="#B8E8E7E3" FontFamily="{StaticResource Ob.Mono}" FontSize="11"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
