<UserControl x:Class="Dictation.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="History" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Your raw speech-recognition text is always kept next to the AI-edited version. Held in memory only; cleared when the app exits."/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="List" DisplayMemberPath="Summary" SelectionChanged="List_SelectionChanged"/>
            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Raw transcript" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="RawBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" Padding="8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Copy raw" Padding="10,4" Margin="0,0,8,0" Click="CopyRaw_Click"/>
                        <Button Content="Insert raw into the last app" Padding="10,4" Click="InsertRaw_Click"/>
                    </StackPanel>
                    <TextBlock Text="Processed transcript" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <TextBox x:Name="ProcBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" Padding="8"/>
                    <Button Content="Copy processed" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" Click="CopyProc_Click"/>
                    <TextBlock x:Name="Info" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
