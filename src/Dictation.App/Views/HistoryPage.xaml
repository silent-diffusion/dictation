<UserControl x:Class="Dictation.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views"
             xmlns:sess="clr-namespace:Dictation.Core.Session;assembly=Dictation.Core">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <local:PageHeader DockPanel.Dock="Top" Title="History" Decor="履歴" Readout="DICTATIONS // ON THIS PC"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SHOW" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="GroupingBox" Width="230" SelectionChanged="Grouping_Changed" AutomationProperties.Name="Order">
                    <ComboBoxItem Content="Newest first" Tag="Chronological"/>
                    <ComboBoxItem Content="By app, newest first" Tag="ByApp"/>
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" Margin="0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The dictations -->
            <Border Style="{StaticResource Card}" Padding="6">
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" SelectionChanged="List_SelectionChanged"
                         ItemContainerStyle="{StaticResource RowItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Dictations"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <!-- A plain list (never a grouped one, which WPF builds in full): only the rows on screen are built,
                         however many dictations there are. By app, each app's header is a row of its own. -->
                    <ListBox.Resources>
                        <!-- By app: the app's name large, its count beside it, + or − to fold it -->
                        <DataTemplate DataType="{x:Type local:HistoryAppHeader}">
                            <Button Click="Header_Click" Cursor="Hand" Focusable="False" Margin="-12,-8,-12,-8"
                                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{DynamicResource Ob.Subtle}" Padding="12,9,12,7">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ob.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Sign}" FontFamily="{StaticResource Ob.Mono}" FontSize="12"
                                               Foreground="{DynamicResource Ob.Muted}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Ob.Text}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Count}" Margin="10,0,0,0" FontFamily="{StaticResource Ob.Mono}" FontSize="10.5"
                                                   Foreground="{DynamicResource Ob.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type sess:HistoryEntry}">
                            <StackPanel Margin="2,5">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Style="{StaticResource MonoLabel}"/>
                                    <TextBlock Style="{StaticResource MonoLabel}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding When, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding AppName, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>
            </Border>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" Margin="16" VerticalAlignment="Top"
                       Text="Nothing here yet. Your dictations appear here, with their recordings."/>

            <!-- One dictation -->
            <ScrollViewer Grid.Column="1" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Detail" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="DELETE" Style="{StaticResource QuietButton}" Click="Delete_Click"
                                VerticalAlignment="Top"/>
                        <Button x:Name="RunAgainButton" DockPanel.Dock="Right" Content="RUN AGAIN" Style="{StaticResource QuietButton}"
                                Click="RunAgain_Click" VerticalAlignment="Top" Margin="0,0,8,0"
                                ToolTip="Transcribe the recording again with today's speech settings, then clean it up again with its profile. The current result is kept, so it can be put back."/>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" FontFamily="{StaticResource Ob.Mono}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="WhereText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            <WrapPanel x:Name="RerunRow" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="RerunText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="SwapButton" Click="Swap_Click" Cursor="Hand" Padding="0" VerticalAlignment="Center"
                                        FontFamily="{StaticResource Ob.Mono}" FontSize="11">
                                    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Recording -->
                    <Border x:Name="Player" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="10,8">
                        <DockPanel>
                            <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Width="34"
                                    Padding="0" Click="Play_Click" AutomationProperties.Name="Play or pause">
                                <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                            <ToggleButton x:Name="SpeedButton" DockPanel.Dock="Right" Content="2×" Padding="10,4" Margin="10,0,0,0"
                                          Click="Speed_Click" ToolTip="Play at double speed" AutomationProperties.Name="Double speed"/>
                            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" FontFamily="{StaticResource Ob.Mono}" FontSize="12"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Slider x:Name="Seek" Margin="12,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                    IsMoveToPointEnabled="True" ValueChanged="Seek_ValueChanged" AutomationProperties.Name="Position"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="NoAudioText" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed"
                               Text="No recording kept for this dictation."/>

                    <!-- The three boxes used everywhere, side by side: Transcription · AI Edit (struck through / added) · Inserted,
                         each with its own COPY beside its name -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="14,12,14,14">
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Tag="Raw" Click="CopyRaw_Click" Content="COPY" Cursor="Hand" Padding="0" Margin="10,0,0,0"
                                        Background="Transparent" BorderThickness="0" FontFamily="{StaticResource Ob.Mono}" FontSize="10.5"
                                        Foreground="{DynamicResource Ob.Muted}" AutomationProperties.Name="Copy Transcription" ToolTip="Copy what you said">
                                    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                                </Button>
                                    <TextBlock Text="01 // TRANSCRIPTION" Style="{StaticResource MonoLabel}"/>
                                </DockPanel>
                                <TextBlock x:Name="TranscriptBlock" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="1,0,0,0">
                                <StackPanel Margin="14,12,14,14">
                                    <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="CopyAiButton" DockPanel.Dock="Right" Tag="Edit" Click="CopyAi_Click" Content="COPY" Cursor="Hand" Padding="0" Margin="10,0,0,0"
                                        Background="Transparent" BorderThickness="0" FontFamily="{StaticResource Ob.Mono}" FontSize="10.5"
                                        Foreground="{DynamicResource Ob.Muted}" AutomationProperties.Name="Copy AI Edit" ToolTip="Copy the AI's own output, before it was fitted into the surrounding text">
                                    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                                </Button>
                                    <TextBlock Text="02 // AI EDIT" Style="{StaticResource MonoLabel}"/>
                                </DockPanel>
                                    <TextBlock x:Name="DiffBlock" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="1,0,0,0">
                                <StackPanel Margin="14,12,14,14">
                                    <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Tag="Inserted" Click="CopyFinal_Click" Content="COPY" Cursor="Hand" Padding="0" Margin="10,0,0,0"
                                        Background="Transparent" BorderThickness="0" FontFamily="{StaticResource Ob.Mono}" FontSize="10.5"
                                        Foreground="{DynamicResource Ob.Muted}" AutomationProperties.Name="Copy Inserted" ToolTip="Copy the text that went in">
                                    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                                </Button>
                                    <TextBlock Text="03 // INSERTED" Style="{StaticResource MonoLabel}"/>
                                </DockPanel>
                                    <TextBlock x:Name="FinalBlock" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="NoteText" Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="INSERT TRANSCRIPTION INTO THE LAST APP" Style="{StaticResource QuietButton}" Margin="0,0,8,8"
                                Click="InsertRaw_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="Info" Style="{StaticResource Caption}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
