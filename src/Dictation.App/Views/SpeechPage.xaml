<UserControl x:Class="Dictation.App.Views.SpeechPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <local:PageHeader Title="Speech recognition" Decor="設定" Readout="SECTION B.2"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Speech is transcribed on this PC by a local engine (faster-whisper, using your NVIDIA GPU when available). Changes apply after you restart the engine."/>
            <TextBlock x:Name="StatusText" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="ENGINE" Style="{StaticResource FieldLabel}"/>
            <ComboBox IsEditable="True" IsReadOnly="True" Text="{Binding Asr.Engine}" Width="260" HorizontalAlignment="Left">
                <ComboBoxItem Content="faster-whisper"/>
            </ComboBox>

            <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}"/>
            <ComboBox IsEditable="True" Text="{Binding Asr.Model, UpdateSourceTrigger=LostFocus}" Width="260" HorizontalAlignment="Left">
                <ComboBoxItem Content="large-v3-turbo"/>
                <ComboBoxItem Content="large-v3"/>
                <ComboBoxItem Content="distil-large-v3"/>
                <ComboBoxItem Content="medium.en"/>
                <ComboBoxItem Content="small.en"/>
                <ComboBoxItem Content="base.en"/>
            </ComboBox>
            <TextBlock x:Name="ModelNote" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

            <TextBlock Text="DEVICE" Style="{StaticResource FieldLabel}"/>
            <ComboBox IsEditable="True" IsReadOnly="True" Text="{Binding Asr.Device}" Width="260" HorizontalAlignment="Left">
                <ComboBoxItem Content="auto"/>
                <ComboBoxItem Content="cuda"/>
                <ComboBoxItem Content="cpu"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="auto = NVIDIA GPU if it works, otherwise CPU (slower)."/>

            <TextBlock Text="LANGUAGE" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Asr.Language, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Two-letter code such as en, de, es. Leave empty to auto-detect (slightly slower, less reliable for short phrases)."/>

            <TextBlock Text="VOCABULARY HINT" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Asr.VocabularyHint, UpdateSourceTrigger=LostFocus}" MaxWidth="560" HorizontalAlignment="Stretch"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Optional names and jargon to bias recognition, e.g. Kubernetes, Dr. Nguyen, Acme Corp."/>

            <TextBlock Text="COMPUTE TYPE (ADVANCED)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Asr.ComputeType, UpdateSourceTrigger=LostFocus}" Width="200" HorizontalAlignment="Left"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Empty = automatic (int8_float16 on GPU, int8 on CPU). Others: float16, int8."/>

            <Button Style="{StaticResource QuietButton}" Content="APPLY AND RESTART SPEECH ENGINE" Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left" Click="Restart_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

