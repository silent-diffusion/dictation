<Window x:Class="Dictation.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oberton" Width="1080" Height="760" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ob.Window}"
        FontFamily="{StaticResource Ob.Ui}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid TextElement.Foreground="{DynamicResource Ob.Text}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Ob.Sidebar}" BorderBrush="{DynamicResource Ob.Divider}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Ob.Mark}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Ob.Record}"/>
                    </Border>
                    <TextBlock Text="Oberton" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,10" CornerRadius="10"
                        Background="{DynamicResource Ob.Subtle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse x:Name="SpeechDot" Style="{StaticResource StatusDot}"/>
                            <TextBlock Text="{Binding Speech}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                       ToolTip="{Binding Speech}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse x:Name="AiDot" Style="{StaticResource StatusDot}"/>
                            <TextBlock Text="{Binding Ai}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                       ToolTip="{Binding Ai}"/>
                        </StackPanel>
                        <TextBlock Text="Nothing leaves this PC." FontSize="11" Foreground="{DynamicResource Ob.Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,0">
                            <TextBlock x:Name="CycleHint" DockPanel.Dock="Right" Style="{StaticResource MonoLabel}" Margin="0,0,10,6"
                                       ToolTip="Press this shortcut in any app to switch to the next profile."/>
                            <TextBlock Text="PROFILES" Style="{StaticResource NavHeader}"/>
                        </DockPanel>
                        <ListBox x:Name="ProfileList" Style="{StaticResource NavList}" SelectionChanged="ProfileList_SelectionChanged"
                                 AutomationProperties.Name="Profiles">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="Normal"
                                                       Foreground="{DynamicResource Ob.Muted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Active" Style="{StaticResource MonoLabel}" Margin="8,2,0,0"
                                                   VerticalAlignment="Top" FontWeight="Normal"
                                                   Visibility="{Binding IsActive, Converter={StaticResource B2V}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Style="{StaticResource DashedButton}" Margin="0,6,0,0" Click="NewProfile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 6,1 L 6,11 M 1,6 L 11,6" Stroke="{DynamicResource Ob.Muted}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="New profile" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SETTINGS" Style="{StaticResource NavHeader}" Margin="10,24,0,6"/>
                        <ListBox x:Name="NavList" Style="{StaticResource NavList}" SelectionChanged="NavList_SelectionChanged"
                                 AutomationProperties.Name="Settings">
                            <ListBoxItem Content="General" Tag="General"/>
                            <ListBoxItem Content="Appearance" Tag="Appearance"/>
                            <ListBoxItem Content="Hotkeys" Tag="Hotkeys"/>
                            <ListBoxItem Content="Speech recognition" Tag="Speech"/>
                            <ListBoxItem Content="AI models" Tag="Models"/>
                            <ListBoxItem Content="Microphone" Tag="Audio"/>
                            <ListBoxItem Content="History" Tag="History"/>
                            <ListBoxItem Content="Advanced" Tag="Advanced"/>
                            <ListBoxItem Content="About &amp; updates" Tag="About"/>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentPresenter x:Name="Host" Grid.Column="1"/>
    </Grid>
</Window>
