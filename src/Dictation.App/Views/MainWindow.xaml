<Window x:Class="Dictation.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oberton" Width="1200" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ob.Window}"
        FontFamily="{StaticResource Ob.Ui}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,14,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- Big, easy-to-read section entries -->
        <Style x:Key="BigNavItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <!-- One layer, not columns: the sidebar slides off to the left (a transform) while the page's left margin shrinks to
         match, so hiding it is a slide rather than a jump. -->
    <Grid TextElement.Foreground="{DynamicResource Ob.Text}">
        <!-- Content -->
        <ContentPresenter x:Name="Host" Margin="268,0,0,0"/>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Width="268" HorizontalAlignment="Left" Panel.ZIndex="1" Background="{DynamicResource Ob.Sidebar}"
                BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="0,0,1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarSlide"/>
            </Border.RenderTransform>
            <DockPanel Margin="14,18,14,14" LastChildFill="True">
                <!-- The logo, to the right of the menu and back buttons (which stay put when the sidebar slides away) -->
                <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="42,3,0,21">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Ob.Mark}">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource Ob.Record}"/>
                        </Border>
                        <TextBlock Text="Oberton" FontSize="18" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,10" CornerRadius="10"
                        Background="{DynamicResource Ob.Subtle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse x:Name="SpeechDot" Style="{StaticResource StatusDot}"/>
                            <TextBlock Text="{Binding Speech}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                       ToolTip="{Binding Speech}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse x:Name="AiDot" Style="{StaticResource StatusDot}"/>
                            <TextBlock Text="{Binding Ai}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                       ToolTip="{Binding Ai}"/>
                        </StackPanel>
                        <TextBlock x:Name="PrivacyText" FontSize="11" Foreground="{DynamicResource Ob.Muted}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- The app's sections -->
                <ListBox x:Name="NavList" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource BigNavItem}" SelectionChanged="NavList_SelectionChanged"
                         AutomationProperties.Name="Sections">
                    <ListBoxItem x:Name="DashboardItem" Tag="Dashboard" AutomationProperties.Name="Active dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Active dashboard"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="SpeechItem" Tag="SpeechToText" AutomationProperties.Name="Speech to text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE720;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Speech to text"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="ReadItem" Tag="ReadAloud" AutomationProperties.Name="Read aloud">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE767;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Read aloud"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="HistoryItem" Tag="History" AutomationProperties.Name="History">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="History"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="SettingsItem" Tag="Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- While the sidebar is hidden: a solid bar across the top holding the menu and Back buttons, so pages start below
             it and nothing scrolls underneath them. -->
        <Border x:Name="TopBar" Height="64" VerticalAlignment="Top" Panel.ZIndex="1" Visibility="Collapsed"
                Background="{DynamicResource Ob.Sidebar}" BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="0,0,0,1"/>

        <!-- Always at the top left: the menu button (☰ that folds into ✕ while the sidebar is open) and Back -->
        <StackPanel Orientation="Horizontal" Panel.ZIndex="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,16,0,0">
            <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Click="Menu_Click" Padding="0">
                <Grid Width="18" Height="14">
                    <Rectangle x:Name="Bar1" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="Bar1Turn"/>
                                <TranslateTransform x:Name="Bar1Move"/>
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar2" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Rectangle x:Name="Bar3" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="Bar3Turn"/>
                                <TranslateTransform x:Name="Bar3Move"/>
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Button>
            <!-- Back: after the logo while the sidebar is open, next to the menu button while it's folded (it slides along) -->
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="6,0,0,0" Click="Back_Click"
                    ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" Visibility="Collapsed">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="BackSlide"/>
                </Button.RenderTransform>
            </Button>
        </StackPanel>
    </Grid>
</Window>
