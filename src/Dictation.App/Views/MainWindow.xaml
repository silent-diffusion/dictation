<Window x:Class="Dictation.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oberton" Width="1200" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ob.Window}"
        FontFamily="{StaticResource Ob.Ui}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid TextElement.Foreground="{DynamicResource Ob.Text}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Ob.Sidebar}" BorderBrush="{DynamicResource Ob.Divider}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Ob.Mark}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Ob.Record}"/>
                    </Border>
                    <TextBlock Text="Oberton" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,10" CornerRadius="10"
                        Background="{DynamicResource Ob.Subtle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse x:Name="SpeechDot" Style="{StaticResource StatusDot}"/>
                            <TextBlock Text="{Binding Speech}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                       ToolTip="{Binding Speech}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse x:Name="AiDot" Style="{StaticResource StatusDot}"/>
                            <TextBlock Text="{Binding Ai}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                       ToolTip="{Binding Ai}"/>
                        </StackPanel>
                        <TextBlock x:Name="PrivacyText" FontSize="11" Foreground="{DynamicResource Ob.Muted}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- The app's sections -->
                <ListBox x:Name="NavList" Style="{StaticResource NavList}" SelectionChanged="NavList_SelectionChanged"
                         AutomationProperties.Name="Sections">
                    <ListBoxItem x:Name="DashboardItem" Tag="Dashboard" AutomationProperties.Name="Active dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Active dashboard"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="SpeechItem" Tag="SpeechToText" AutomationProperties.Name="Speech to text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE720;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Speech to text"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="ReadItem" Tag="ReadAloud" AutomationProperties.Name="Read aloud">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE767;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Read aloud"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="HistoryItem" Tag="History" AutomationProperties.Name="History">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="History"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="SettingsItem" Tag="Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentPresenter x:Name="Host" Grid.Column="1"/>
    </Grid>
</Window>
