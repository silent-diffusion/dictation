<Window x:Class="Dictation.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views"
        Title="Oberton setup" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ob.Window}"
        FontFamily="{StaticResource Ob.Ui}">
    <StackPanel Margin="44,40,44,32" TextElement.Foreground="{DynamicResource Ob.Text}">
        <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="5" Background="{DynamicResource Ob.Mark}" HorizontalAlignment="Left">
                <Ellipse Width="11" Height="11" Fill="{DynamicResource Ob.MarkDot}"/>
            </Border>
            <TextBlock Text="OBERTON" FontFamily="{StaticResource Ob.Mono}" FontSize="16" FontWeight="Bold" Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
            <local:DecorText Text="倍音" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="DICTATION THAT NEVER LEAVES YOUR PC" Style="{StaticResource SectionTitle}" FontSize="26" Margin="0,22,0,0"
                   TextWrapping="Wrap"/>
        <Border Style="{StaticResource Rule}" Margin="0,10,0,0"/>
        <TextBlock x:Name="Intro" TextWrapping="Wrap" FontSize="15" LineHeight="22" Margin="0,8,0,0"
                   Foreground="{DynamicResource Ob.Muted}"/>

        <Border Style="{StaticResource Card}" Margin="0,24,0,0">
            <StackPanel>
                <DockPanel Margin="18,14">
                    <Path x:Name="HardwareIcon" Data="M 2.5,9.5 L 6.5,13.5 L 15,4.5" Stroke="{DynamicResource Ob.Ok}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HardwareText" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="PlanList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="0,1,0,0" Padding="18,11">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    <TextBlock Text="{Binding What}" Style="{StaticResource MonoLabel}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="ProgressPanel" BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="0,1,0,0"
                        Padding="18,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="StepText" FontSize="13" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="Bar" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1"/>
                        <TextBlock x:Name="DetailText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ob.Muted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Ob.Error}"
                   Visibility="Collapsed"/>

        <DockPanel Margin="0,24,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="CancelButton" Content="QUIT" Style="{StaticResource QuietButton}" MinHeight="40" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button x:Name="StartButton" Content="SET UP" Style="{StaticResource PrimaryButton}" MinHeight="40"
                        Click="Start_Click" IsDefault="True"/>
            </StackPanel>
            <TextBlock x:Name="PlanText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource Ob.Muted}"/>
        </DockPanel>
    </StackPanel>
</Window>
