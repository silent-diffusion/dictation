<UserControl x:Class="Dictation.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="980" HorizontalAlignment="Stretch">
            <TextBlock Text="Active dashboard" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Caption}"/>
            <UniformGrid x:Name="Cards" Columns="2" Margin="-8,4,-8,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
