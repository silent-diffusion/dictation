<UserControl x:Class="Dictation.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- At a glance: everything fits the window, nothing scrolls. Rows share the height; dials scale to their cells. -->
    <Grid Margin="28,22,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.05*" MinHeight="110"/>
            <RowDefinition Height="1.15*" MinHeight="120"/>
            <RowDefinition Height="1.3*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="4,0,4,10">
            <TextBlock x:Name="Clock" DockPanel.Dock="Right" Style="{StaticResource MonoLabel}" VerticalAlignment="Bottom"/>
            <StackPanel>
                <TextBlock Text="Active dashboard" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="Summary" FontSize="12.5" Foreground="{DynamicResource Ob.Muted}" TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- What is active and loaded -->
        <UniformGrid x:Name="Tiles" Grid.Row="1" Columns="4" Rows="1"/>

        <!-- Dials -->
        <UniformGrid x:Name="Dials" Grid.Row="2" Columns="5" Rows="1" Margin="0,4,0,0"/>

        <!-- Charts -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="DaysCard" Style="{StaticResource Card}" Margin="4" Padding="16,12,16,10"/>
            <Border x:Name="AppsCard" Grid.Column="1" Style="{StaticResource Card}" Margin="4" Padding="16,12,16,10"/>
        </Grid>

        <TextBlock x:Name="Footer" Grid.Row="4" FontSize="11.5" Foreground="{DynamicResource Ob.Muted}" Margin="6,8,6,0"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
