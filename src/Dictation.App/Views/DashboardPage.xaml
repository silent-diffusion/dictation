<UserControl x:Class="Dictation.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <UserControl.Resources>
        <!-- A cell of the instrument panel: cells share hairline edges instead of floating as cards -->
        <Style x:Key="DashCell" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Ob.Divider}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Ob.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- At a glance: everything fits the window, nothing scrolls. Rows share the height; dials scale to their cells. -->
    <Grid Margin="28,20,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <DockPanel>
                <TextBlock x:Name="Clock" DockPanel.Dock="Right" Style="{StaticResource MonoLabel}" VerticalAlignment="Bottom"
                           Margin="16,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DASHBOARD" Style="{StaticResource SectionTitle}" FontSize="30" Margin="0"/>
                    <local:DecorText Text="計器" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ob.Divider}"
                                     VerticalAlignment="Bottom" Margin="12,0,0,1"/>
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Rule}" Margin="0,6,0,6"/>
            <TextBlock x:Name="Summary" FontSize="12.5" Foreground="{DynamicResource Ob.Muted}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- The panel: its top and left edges here, each cell draws its right and bottom edges -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="1,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.0*" MinHeight="104"/>
                    <RowDefinition Height="1.15*" MinHeight="120"/>
                    <RowDefinition Height="1.3*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- The signal path: profile → speech recognition → AI cleanup → read aloud -->
                <UniformGrid x:Name="Tiles" Columns="4" Rows="1"/>

                <!-- Meters -->
                <UniformGrid x:Name="Dials" Grid.Row="1" Columns="6" Rows="1"/>

                <!-- Charts -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DaysCard" Style="{StaticResource DashCell}" Padding="16,12,16,10"/>
                    <Border x:Name="AppsCard" Grid.Column="1" Style="{StaticResource DashCell}" Padding="16,12,16,10"/>
                </Grid>
            </Grid>
        </Border>

        <TextBlock x:Name="Footer" Grid.Row="2" Style="{StaticResource MonoLabel}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>

        <!-- A short note, e.g. after the History number copies the last dictation -->
        <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"
                Padding="18,8" CornerRadius="17" Background="{DynamicResource Ob.Strong}" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontFamily="{StaticResource Ob.Mono}" FontSize="12" Foreground="{DynamicResource Ob.OnStrong}"
                       TextWrapping="Wrap" MaxWidth="480"/>
        </Border>
    </Grid>
</UserControl>
