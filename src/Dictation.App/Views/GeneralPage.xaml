<UserControl x:Class="Dictation.App.Views.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Everything runs on this computer. No audio or text is ever sent anywhere, and there is no telemetry."/>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel Margin="18,0">
                    <CheckBox Style="{StaticResource Switch}" Content="Start with Windows (minimized to the tray)"
                              IsChecked="{Binding StartWithWindows}"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Keep running in the tray when the window is closed"
                              IsChecked="{Binding MinimizeToTray}"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepHistory}" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="Keep the last 25 dictations for the History page" TextWrapping="Wrap"/>
                            <TextBlock Text="Raw and processed text, held in memory only and discarded when the app exits."
                                       FontSize="12" Foreground="{DynamicResource Ob.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <TextBlock Text="Text insertion method" Style="{StaticResource FieldLabel}" Margin="0,24,0,6"/>
            <ComboBox x:Name="InsertionBox" SelectedItem="{Binding Insertion}" Width="220" HorizontalAlignment="Left"
                      AutomationProperties.Name="Text insertion method"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Auto pastes the text (your clipboard is saved and restored afterwards), the most reliable method in every kind of app. Typing sends keystrokes instead and never touches the clipboard, but is slower. Typing is also used automatically if pasting fails. Per-app overrides: AppOverrides in data\settings.json."/>

            <TextBlock Text="Maximum length of one dictation (seconds)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding MaxRecordingSeconds, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"
                     AutomationProperties.Name="Maximum length of one dictation in seconds"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
