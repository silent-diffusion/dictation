<UserControl x:Class="Dictation.App.Views.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <local:PageHeader Title="Hotkeys" Decor="設定" Readout="SECTION A.2"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="Click a box and press the shortcut you want. Shortcuts work in every application. Use at least one of Ctrl, Alt, Shift or Win (or an F-key)."/>

            <TextBlock Text="START / STOP DICTATION" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ToggleBox" IsReadOnly="True" Width="240" Padding="8,6" IsReadOnlyCaretVisible="False"
                         PreviewKeyDown="Toggle_KeyDown" GotKeyboardFocus="Box_Focus"/>
                <Button Style="{StaticResource QuietButton}" Content="RESET" Margin="8,0,0,0" Padding="12,6" Click="ResetToggle_Click"/>
            </StackPanel>

            <TextBlock Text="SWITCH TO NEXT PROFILE" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="CycleBox" IsReadOnly="True" Width="240" Padding="8,6" IsReadOnlyCaretVisible="False"
                         PreviewKeyDown="Cycle_KeyDown" GotKeyboardFocus="Box_Focus"/>
                <Button Style="{StaticResource QuietButton}" Content="CLEAR" Margin="8,0,0,0" Padding="12,6" Click="ClearCycle_Click"/>
            </StackPanel>

            <TextBlock Text="READ SELECTED TEXT ALOUD" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SpeakBox" IsReadOnly="True" Width="240" Padding="8,6" IsReadOnlyCaretVisible="False"
                         PreviewKeyDown="Speak_KeyDown" GotKeyboardFocus="Box_Focus"/>
                <Button Style="{StaticResource QuietButton}" Content="RESET" Margin="8,0,0,0" Padding="12,6" Click="ResetSpeak_Click"/>
            </StackPanel>

            <TextBlock Text="EXTENDED NOTES MARKER" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="MarkerBox" IsReadOnly="True" Width="240" Padding="8,6" IsReadOnlyCaretVisible="False"
                         PreviewKeyDown="Marker_KeyDown" GotKeyboardFocus="Box_Focus"/>
                <Button Style="{StaticResource QuietButton}" Content="CLEAR" Margin="8,0,0,0" Padding="12,6" Click="ClearMarker_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Drops a time marker (⚑ h:mm:ss) into the transcript while an extended notes session records, from whatever application you are in. The key is only taken while a session records; the rest of the time it stays with the application that uses it."/>

            <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0"
                       Text="Tip: a hotkey here is taken from every other app while Oberton runs (Ctrl+D then no longer bookmarks a page in a browser, and Ctrl+Space no longer switches input methods). If one doesn't fire, or you miss what it did, pick another combination such as F9."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
