<UserControl x:Class="Dictation.App.Views.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Advanced" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Caption}" Text="Where things are stored on this computer, and what is installed."/>

            <TextBlock Text="Local models" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="ModelsText" TextWrapping="Wrap"/>

            <TextBlock Text="Locations" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="PathsText" TextWrapping="Wrap" FontFamily="Consolas"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Open data folder" Padding="12,6" Margin="0,0,8,0" Click="OpenData_Click"/>
                <Button Content="Open logs" Padding="12,6" Margin="0,0,8,0" Click="OpenLogs_Click"/>
                <Button Content="Open models folder" Padding="12,6" Click="OpenModels_Click"/>
            </StackPanel>

            <TextBlock Text="Privacy" Style="{StaticResource FieldLabel}"/>
            <TextBlock TextWrapping="Wrap"
                       Text="No cloud services, accounts, analytics or telemetry. The speech engine runs offline (Hugging Face access is disabled at runtime) and the AI runtime only listens on 127.0.0.1. Logs record timings and sizes, never what you said. Audio is never written to disk."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
