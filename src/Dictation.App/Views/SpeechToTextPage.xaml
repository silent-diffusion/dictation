<UserControl x:Class="Dictation.App.Views.SpeechToTextPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Profiles -->
        <Border BorderBrush="{DynamicResource Ob.Border}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SideMenu" Margin="12,26,12,16">
                    <DockPanel Margin="12,0,12,6">
                        <local:DecorText DockPanel.Dock="Right" Text="口述" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        <TextBlock Text="SPEECH TO TEXT" FontFamily="{StaticResource Ob.Mono}" FontSize="18" FontWeight="Bold"/>
                    </DockPanel>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}" Margin="12,0,8,16" FontSize="12"/>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock x:Name="CycleHint" DockPanel.Dock="Right" Style="{StaticResource MonoLabel}" Margin="0,0,12,6"
                                   ToolTip="Press this shortcut in any app to switch to the next profile."/>
                        <TextBlock Text="PROFILES" Style="{StaticResource NavHeader}" Margin="12,0,0,6"/>
                    </DockPanel>
                    <Border Style="{StaticResource Rule}"/>
                    <ListBox x:Name="ProfileList" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource RowItem}"
                             SelectionChanged="ProfileList_SelectionChanged" AutomationProperties.Name="Profiles">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="Normal" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource Ob.Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- The active profile: a filled dot and a readout, in the accent (it is what dictation uses now) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,3,0,0" VerticalAlignment="Top"
                                                Visibility="{Binding IsActive, Converter={StaticResource B2V}}">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Ob.Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="ACTIVE" Style="{StaticResource MonoLabel}" Foreground="{DynamicResource Ob.Accent}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Style="{StaticResource DashedButton}" Margin="0,10,0,0" Click="NewProfile_Click" AutomationProperties.Name="New profile">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 6,1 L 6,11 M 1,6 L 11,6" Stroke="{DynamicResource Ob.Muted}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="NEW PROFILE"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ContentPresenter x:Name="Host" Grid.Column="1"/>
    </Grid>
</UserControl>
