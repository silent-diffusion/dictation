<UserControl x:Class="Dictation.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <UserControl.Resources>
        <!-- A numbered section: its address on the left, the content on the right, a hairline below -->
        <Style x:Key="Section" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="Address" TargetType="TextBlock" BasedOn="{StaticResource MonoLabel}">
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource Ob.Muted}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Ob.Divider}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Ob.Mono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Ob.Muted}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="GlossWord" TargetType="local:DecorText">
            <Setter Property="FontFamily" Value="{StaticResource Ob.Jp}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ob.Text}"/>
            <Setter Property="Margin" Value="0,6,12,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GlossReading" TargetType="TextBlock">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource Ob.Muted}"/>
            <Setter Property="Margin" Value="0,6,12,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GlossEnglish" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Ob.Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,12,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GlossWhere" TargetType="TextBlock" BasedOn="{StaticResource MonoLabel}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GlossRule" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Ob.Divider}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Grid.ColumnSpan" Value="4"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="820" HorizontalAlignment="Left">
            <local:PageHeader Title="Oberton" Decor="倍音" Readout="SECTION D.2&#x0a;ABOUT"/>
            <TextBlock x:Name="VersionText" FontFamily="{StaticResource Ob.Mono}" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8">
                <Run Text="Free and open source (MIT license). "/>
                <Hyperlink x:Name="RepoLink" Click="Repo_Click" Foreground="{DynamicResource Ob.Text}">Project page on GitHub</Hyperlink>
            </TextBlock>

            <!-- D.2.1 What it is -->
            <Border Style="{StaticResource Divider}" Margin="0,10,0,0"/>
            <Grid Margin="0,16,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="D.2.1" Style="{StaticResource Address}"/>
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <local:DecorText DockPanel.Dock="Right" Text="概要"/>
                        <TextBlock Text="WHAT IT IS" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="Oberton is a dictation and read-aloud app for Windows that runs entirely on your PC." Foreground="{DynamicResource Ob.Text}"/>
                        <Run Text="Press"/>
                        <Run x:Name="DictateKey" Text="Ctrl+D" Foreground="{DynamicResource Ob.Text}" FontFamily="{StaticResource Ob.Mono}"/><Run Text=", speak, and press it again: cleaned-up text appears at your cursor, in any app. Select text and press"/>
                        <Run x:Name="SpeakKey" Text="Ctrl+Space" Foreground="{DynamicResource Ob.Text}" FontFamily="{StaticResource Ob.Mono}"/>
                        <Run Text="to hear it read in a natural voice. For a lecture or a meeting,"/>
                        <Run Text="Extended Notes" Foreground="{DynamicResource Ob.Text}"/>
                        <Run Text="listens for as long as it lasts and keeps a transcript, a formatted version and a running summary, with the recording."/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="The name is German for"/>
                        <Run Text="overtone" Foreground="{DynamicResource Ob.Text}"/><Run Text=": the AI adds a layer of polish on top of your own voice."/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- D.2.2 How it works -->
            <Border Style="{StaticResource Divider}"/>
            <Grid Margin="0,16,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="D.2.2" Style="{StaticResource Address}"/>
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <local:DecorText DockPanel.Dock="Right" Text="口述"/>
                        <TextBlock Text="HOW IT WORKS" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </DockPanel>
                    <!-- The four steps of a dictation, left to right, in an ink frame -->
                    <Border BorderBrush="{DynamicResource Ob.Border}" BorderThickness="1" Margin="0,10,0,0">
                        <UniformGrid Columns="4" Rows="1">
                            <Border Style="{StaticResource Step}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="01 LISTEN" Style="{StaticResource StepTitle}"/>
                                    <TextBlock Style="{StaticResource StepText}" Text="Your microphone is recorded while the hotkey is on. The recording is kept in History only if you choose to (Settings › History)."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Step}">
                                <StackPanel>
                                    <TextBlock Text="02 TRANSCRIBE" Style="{StaticResource StepTitle}"/>
                                    <TextBlock Style="{StaticResource StepText}" Text="Whisper turns speech into text as you speak, on your graphics card if you have one."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Step}">
                                <StackPanel>
                                    <TextBlock Text="03 TIDY UP" Style="{StaticResource StepTitle}"/>
                                    <TextBlock Style="{StaticResource StepText}" Text="A local language model (through Ollama) edits the text, following the active profile's instructions."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Step}">
                                <StackPanel>
                                    <TextBlock Text="04 INSERT" Style="{StaticResource StepTitle}"/>
                                    <TextBlock Style="{StaticResource StepText}" Text="Finished sentences can appear while you speak; at the end the final text replaces them at your cursor, and your clipboard is put back."/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0">
                        <Run Text="If the AI fails or its edit strays too far from what you said (the profile's safety net), your own words are inserted instead, so a dictation is never lost. The dashboard's signal path lights each step while it works. Read aloud uses Kokoro, Piper or the voices built into Windows."/>
                        <Run Text="Nothing leaves your PC" Foreground="{DynamicResource Ob.Text}"/>
                        <Run Text="unless you turn off Keep everything offline and choose a cloud model; the only other network use is downloading the models and voices you pick, and checking for updates."/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- D.2.3 Extended Notes: the four steps, how often each runs, and a session on a time line -->
            <Border Style="{StaticResource Divider}"/>
            <Grid Margin="0,16,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="D.2.3" Style="{StaticResource Address}"/>
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <local:DecorText DockPanel.Dock="Right" Text="記録"/>
                        <TextBlock Text="HOW EXTENDED NOTES WORKS" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Body}"
                               Text="A session runs four steps side by side, each on its own rhythm, so the text keeps up with a lecture of any length while the AI only ever reads as much as fits in its memory at once."/>
                    <Border BorderBrush="{DynamicResource Ob.Border}" BorderThickness="1" Margin="0,10,0,0">
                        <UniformGrid Columns="4" Rows="1">
                            <Border Style="{StaticResource Step}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="01 LISTEN" Style="{StaticResource StepTitle}"/>
                                    <TextBlock Text="ALL THE TIME" Style="{StaticResource StepTitle}" Foreground="{DynamicResource Ob.Accent}" FontWeight="Normal" Margin="0,3,0,0"/>
                                    <TextBlock Style="{StaticResource StepText}" Text="The microphone, the computer's audio, or both, recorded to the session's folder. Type your own lines in, or press the marker key (⚑) to flag a moment."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Step}">
                                <StackPanel>
                                    <TextBlock Text="02 SPEECH" Style="{StaticResource StepTitle}"/>
                                    <TextBlock Text="EVERY ~5 SECONDS" Style="{StaticResource StepTitle}" Foreground="{DynamicResource Ob.Accent}" FontWeight="Normal" Margin="0,3,0,0"/>
                                    <TextBlock Style="{StaticResource StepText}" Text="Whisper adds each finished sentence to the transcript (at the latest after 12 seconds). Phrases it invents in silence are dropped. If the engine restarts, up to 3 minutes of audio wait for it."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Step}">
                                <StackPanel>
                                    <TextBlock Text="03 FORMAT" Style="{StaticResource StepTitle}"/>
                                    <TextBlock Text="EVERY 110 WORDS · 90 S AT MOST" Style="{StaticResource StepTitle}" Foreground="{DynamicResource Ob.Accent}" FontWeight="Normal" Margin="0,3,0,0"/>
                                    <TextBlock Style="{StaticResource StepText}" Text="The AI adds punctuation, paragraphs and headings to the new words. An edit that adds more than a tenth new words, keeps under 40% of them, or brings in a number is refused, and the words stay as heard."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Step}">
                                <StackPanel>
                                    <TextBlock Text="04 SUMMARY" Style="{StaticResource StepTitle}"/>
                                    <TextBlock Text="EVERY ~6 MINUTES · 10 AT MOST" Style="{StaticResource StepTitle}" Foreground="{DynamicResource Ob.Accent}" FontWeight="Normal" Margin="0,3,0,0"/>
                                    <TextBlock Style="{StaticResource StepText}" Text="Each section of formatted text (about 6,000 characters) is summed up in a sixth of its length; every four summaries fold into one. At Stop: the main idea, three bullets, at most three paragraphs."/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <!-- A 30-minute session on a time line, drawn in code (AboutPage.xaml.cs) -->
                    <Border BorderBrush="{DynamicResource Ob.Border}" BorderThickness="1,0,1,1" Padding="12,12,12,8">
                        <StackPanel>
                            <TextBlock Text="A 30-MINUTE LECTURE, STEP BY STEP" Style="{StaticResource MonoLabel}"/>
                            <Viewbox x:Name="NotesTimelineBox" Stretch="Uniform" StretchDirection="Both" Margin="0,8,0,0"
                                     AutomationProperties.Name="A 30-minute session on a time line: speech every 5 seconds, formatting about every minute, a summary section about every 6 to 7 minutes, the first four summaries folded into one, and the final summary at Stop."/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0">
                        <Run Text="Why these sizes:" Foreground="{DynamicResource Ob.Text}"/>
                        <Run Text="the AI model reads at most 4,096 tokens per request, about 9,400 characters or ten minutes of speech, with room left for its instructions and reply. Summing up in sections, then summaries of summaries, keeps every request inside that window however long the session runs. Nothing is sent to the AI while you dictate, so dictation always comes first."/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="The model:" Foreground="{DynamicResource Ob.Text}"/>
                        <Run Text="by default the largest installed one that fits your graphics card's memory, or a mixture-of-experts model such as Qwen3 30B-A3B that fits in the PC's memory (what fits goes on the graphics card, the rest stays in RAM) (Settings › Models › Extended Notes AI). After a session you can play the recording (made louder, skipping silences), jump from any line to the moment it was said, export it, or click a step at the top of the session to redo it. Extended Notes never counts toward your dictation figures; Analytics shows it in a section of its own."/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- D.2.4 What it keeps -->
            <Border Style="{StaticResource Divider}"/>
            <Grid Margin="0,16,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="D.2.4" Style="{StaticResource Address}"/>
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <local:DecorText DockPanel.Dock="Right" Text="履歴"/>
                        <TextBlock Text="WHAT IT KEEPS" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Body}"
                               Text="Everything stays in Oberton's data folder on this PC, outside the program folder, so updates never touch it:"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="HISTORY" Style="{StaticResource GlossWhere}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource StepText}" Margin="0,6,0,6"
                                   Text="Each dictation's text, AI edit, app and window, and its recording: by number or by age, text and recordings set apart (Settings › History)."/>
                        <TextBlock Grid.Row="1" Text="DAILY COUNTS" Style="{StaticResource GlossWhere}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StepText}" Margin="0,6,0,6"
                                   Text="Numbers only, for the dashboard and Analytics: words, time, turnaround, readings, apps and a browser's site names. Never any text, audio or window titles."/>
                        <TextBlock Grid.Row="2" Text="WORD TALLY" Style="{StaticResource GlossWhere}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StepText}" Margin="0,6,0,6"
                                   Text="Counts of the words, phrases, corrections and fillers you dictate, overall and per app. Never whole sentences. Can be turned off."/>
                        <TextBlock Grid.Row="3" Text="EXTENDED NOTES" Style="{StaticResource GlossWhere}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource StepText}" Margin="0,6,0,6"
                                   Text="Each session's recording, transcript, formatted text and summary, until you delete it, and its own counts, kept apart from dictation."/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- D.2.5 Design language -->
            <Border Style="{StaticResource Divider}"/>
            <Grid Margin="0,16,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="D.2.5" Style="{StaticResource Address}"/>
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <local:DecorText DockPanel.Dock="Right" Text="計器"/>
                        <TextBlock Text="DESIGN LANGUAGE" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="Oberton is drawn like a"/>
                        <Run Text="printed instrument panel" Foreground="{DynamicResource Ob.Text}"/><Run Text=": black ink on gray paper, 1px lines and readouts, with no cards or shadows. Dark mode is the same sheet with ink and paper swapped."/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="Color is a signal, not decoration."/>
                        <Run Text="The accent color marks what is live" Foreground="{DynamicResource Ob.Accent}"/><Run Text=": today's count, a countdown, a step at work (its dot pulses), the word being read, words the AI added."/>
                        <Run Text="Red means the microphone is open" Foreground="{DynamicResource Ob.Text}"/>
                        <Run Text="and appears nowhere else. You can choose the accent under Appearance."/>
                    </TextBlock>
                    <TextBlock x:Name="GlossaryIntro" Style="{StaticResource Body}"
                               Text="The small Japanese words beside labels are decoration. Each one matches what it sits next to, and none of them is needed to use the app:"/>

                    <!-- Every Japanese word in the interface, with its reading and meaning. The Japanese column is decoration
                         (screen readers skip it); the other columns carry the meaning. -->
                    <Grid x:Name="Glossary" Margin="0,12,0,0" AutomationProperties.Name="The Japanese words in Oberton and what they mean">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource GlossRule}" BorderBrush="{DynamicResource Ob.Border}"/>
                        <TextBlock Text="WORD" Style="{StaticResource GlossWhere}"/>
                        <TextBlock Grid.Column="1" Text="READING" Style="{StaticResource GlossWhere}"/>
                        <TextBlock Grid.Column="2" Text="ENGLISH" Style="{StaticResource GlossWhere}"/>
                        <TextBlock Grid.Column="3" Text="WHERE YOU SEE IT" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="1" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="1" Text="倍音" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="baion" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Overtone (Oberton is German for the same thing)" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="SIDEBAR, ABOUT" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="2" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="2" Text="計器" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="keiki" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Instrument, gauge" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="DASHBOARD" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="3" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="3" Text="口述" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="kōjutsu" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Dictation, spoken account" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="SPEECH TO TEXT" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="4" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="4" Text="読上" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="yomiage" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Reading aloud (short for 読み上げ)" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="READ ALOUD" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="5" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="5" Text="履歴" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="rireki" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="History, record" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="HISTORY" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="6" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="6" Text="設定" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="settei" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Settings" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="6" Grid.Column="3" Text="SETTINGS AND EACH OF ITS PAGES" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="7" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="7" Text="概要" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="gaiyō" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="Overview, about" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="7" Grid.Column="3" Text="THIS PAGE" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="8" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="8" Text="録音" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="rokuon" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Text="Recording" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="8" Grid.Column="3" Text="OVERLAY, WHILE RECORDING" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="9" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="9" Text="処理中" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="shorichū" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="Processing" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="9" Grid.Column="3" Text="OVERLAY, WHILE TRANSCRIBING AND TIDYING UP" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="10" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="10" Text="挿入" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="sōnyū" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="Insertion" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="10" Grid.Column="3" Text="OVERLAY, AFTER INSERTING" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="11" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="11" Text="記録" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="kiroku" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="11" Grid.Column="2" Text="Record, notes" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="11" Grid.Column="3" Text="EXTENDED NOTES" Style="{StaticResource GlossWhere}"/>

                        <Border Grid.Row="12" Style="{StaticResource GlossRule}"/>
                        <local:DecorText Grid.Row="12" Text="分析" Style="{StaticResource GlossWord}"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="bunseki" Style="{StaticResource GlossReading}"/>
                        <TextBlock Grid.Row="12" Grid.Column="2" Text="Analysis" Style="{StaticResource GlossEnglish}"/>
                        <TextBlock Grid.Row="12" Grid.Column="3" Text="ANALYTICS" Style="{StaticResource GlossWhere}"/>
                    </Grid>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
