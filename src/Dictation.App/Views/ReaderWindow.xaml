<Window x:Class="Dictation.App.Views.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        ThemeMode="None" Title="Oberton read aloud" FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- Same look as the dictation overlay: an ink panel in both themes, never takes focus from the app being read.
         The accent marks what is live: the word being read and the progress. -->
    <Window.Resources>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E7E3"/>
            <Setter Property="Background" Value="#1AE8E7E3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#E8E7E3"/>
            <Setter Property="Foreground" Value="#0D0D0C"/>
        </Style>
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="16" CornerRadius="16" Padding="16,12,12,14" Background="#F00D0D0C"
            BorderBrush="#24E8E7E3" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>
        <Grid x:Name="Root" Width="520">

            <!-- Player -->
            <StackPanel x:Name="Player">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundButton}" Click="Back_Click" ToolTip="Back 15 seconds"
                                AutomationProperties.Name="Back 15 seconds">
                            <!-- The number above the arrow: overlaid, the digits ran into the arrow's curve. -->
                            <StackPanel>
                                <TextBlock Text="15" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           LineHeight="11" LineStackingStrategy="BlockLineHeight"/>
                                <TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}" FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="8,0" Click="Play_Click"
                                ToolTip="Pause" AutomationProperties.Name="Play or pause">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE769;" Style="{StaticResource Glyph}" FontSize="17"/>
                        </Button>
                        <Button Style="{StaticResource RoundButton}" Click="Forward_Click" ToolTip="Forward 15 seconds"
                                AutomationProperties.Name="Forward 15 seconds">
                            <!-- The number above the arrow: overlaid, the digits ran into the arrow's curve. -->
                            <StackPanel>
                                <TextBlock Text="15" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           LineHeight="11" LineStackingStrategy="BlockLineHeight"/>
                                <TextBlock Text="&#xE7A6;" Style="{StaticResource Glyph}" FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="SlowerButton" Style="{StaticResource RoundButton}" Width="30" Height="30" Click="Slower_Click"
                                ToolTip="Slower" AutomationProperties.Name="Slower">
                            <TextBlock Text="&#xE738;" Style="{StaticResource Glyph}" FontSize="11"/>
                        </Button>
                        <Button x:Name="SpeedButton" Click="Speed_Click" Width="54" Height="30" Margin="2,0" Focusable="False" Cursor="Hand"
                                ToolTip="Choose a speed" AutomationProperties.Name="Choose a speed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="15" BorderThickness="1" BorderBrush="#38E8E7E3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="SpeedText" Text="1.0×" Foreground="#E8E7E3" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
                        </Button>
                        <Popup x:Name="SpeedMenu" PlacementTarget="{Binding ElementName=SpeedButton}" Placement="Top" VerticalOffset="-6"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#F20D0D0C" BorderBrush="#38E8E7E3" BorderThickness="1" CornerRadius="10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="SPEED" Foreground="#99E8E7E3" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Margin="4,0,0,6"/>
                                    <UniformGrid x:Name="SpeedChoices" Columns="4"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button x:Name="FasterButton" Style="{StaticResource RoundButton}" Width="30" Height="30" Click="Faster_Click"
                                ToolTip="Faster" AutomationProperties.Name="Faster">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="RemainingText" Foreground="#E8E7E3" FontFamily="Cascadia Mono, Consolas" FontSize="15"
                                   HorizontalAlignment="Right" ToolTip="Estimated time left"/>
                        <TextBlock x:Name="StatusText" Foreground="#99E8E7E3" FontFamily="Cascadia Mono, Consolas" FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="ExpandButton" Style="{StaticResource RoundButton}" Width="30" Height="30" Margin="0,0,6,0"
                                Click="Expand_Click" ToolTip="Show the whole text" AutomationProperties.Name="Show the whole text">
                            <TextBlock x:Name="ExpandGlyph" Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource RoundButton}" Width="30" Height="30"
                                Click="Close_Click" ToolTip="Stop" AutomationProperties.Name="Stop reading">
                            <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="#E8E7E3" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Progress through the whole text: a ruler, filled in the accent as it reads -->
                <Grid Height="6" Margin="2,12,2,10">
                    <Rectangle Height="6" VerticalAlignment="Bottom">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,6" ViewportUnits="Absolute" Stretch="None">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#40E8E7E3">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,1,6"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border Height="1" VerticalAlignment="Bottom" Background="#40E8E7E3"/>
                    <Border x:Name="ProgressFill" Height="2" VerticalAlignment="Bottom" Background="#E8E7E3" HorizontalAlignment="Left" Width="0"/>
                </Grid>

                <!-- The sentence being read, highlighted as it goes; at most two lines -->
                <TextBlock x:Name="Lines" Foreground="#73E8E7E3" FontSize="16" LineHeight="24" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="48" Margin="2,0,2,0"/>

                <!-- Expanded: the whole text, read so far in white, the current word accented; scrolls along -->
                <ScrollViewer x:Name="FullScroll" ScrollChanged="FullScroll_ScrollChanged" Visibility="Collapsed" MaxHeight="380" Focusable="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="2,0,0,0">
                    <TextBlock x:Name="FullText" Foreground="#73E8E7E3" FontSize="15" LineHeight="23" TextWrapping="Wrap" Cursor="Hand"
                               MouseLeftButtonUp="FullText_MouseLeftButtonUp" ToolTip="Click a word to read from there"
                               Margin="0,0,12,4"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Question: clipboard, or download -->
            <StackPanel x:Name="Question" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Width="30" Height="30" VerticalAlignment="Top"
                            Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="#E8E7E3" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <TextBlock x:Name="QuestionTitle" Foreground="#E8E7E3" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="2,0,12,0"/>
                </DockPanel>
                <TextBlock x:Name="QuestionBody" Foreground="#B3E8E7E3" FontSize="13.5" LineHeight="20" TextWrapping="Wrap"
                           Margin="2,8,12,0" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                <Grid x:Name="DownloadProgress" Height="4" Margin="2,12,12,0" Visibility="Collapsed">
                    <Border Background="#26E8E7E3"/>
                    <Border x:Name="DownloadFill" Background="#E8E7E3" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <StackPanel x:Name="QuestionButtons" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource PillButton}" Background="#E8E7E3" Foreground="#0D0D0C" FontWeight="SemiBold"
                            Click="Primary_Click"/>
                    <Button Style="{StaticResource PillButton}" Margin="8,0,0,0" Content="CANCEL" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
