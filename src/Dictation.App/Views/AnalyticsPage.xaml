<UserControl x:Class="Dictation.App.Views.AnalyticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dictation.App.Views">
    <!-- Over time, where the dashboard is right now: how you dictate, what gets corrected, the words you reach for.
         The panels are drawn in code from the daily counts (usage.json) and the word tally (words.json). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,24">
            <DockPanel>
                <StackPanel x:Name="Periods" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom"
                            Margin="16,0,0,2" AutomationProperties.Name="Period"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ANALYTICS" Style="{StaticResource SectionTitle}" FontSize="30" Margin="0"/>
                    <local:DecorText Text="分析" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ob.Divider}"
                                     VerticalAlignment="Bottom" Margin="12,0,0,1"/>
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Rule}" Margin="0,6,0,6"/>
            <DockPanel Margin="0,0,0,14">
                <TextBlock x:Name="TallyNote" DockPanel.Dock="Right" Style="{StaticResource MonoLabel}" VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                <TextBlock x:Name="Summary" FontSize="12.5" Foreground="{DynamicResource Ob.Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <StackPanel x:Name="Body"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
