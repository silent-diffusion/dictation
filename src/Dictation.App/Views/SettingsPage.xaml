<UserControl x:Class="Dictation.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Settings entries: a step larger than before, easy to read and hit -->
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="14.5"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings sections, in collapsible groups -->
        <Border BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Groups" Margin="14,30,14,16">
                    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,16"/>
                    <Expander x:Name="DictationGroup" IsExpanded="True" Margin="0,0,0,10" Expanded="Group_Toggled" Collapsed="Group_Toggled">
                        <Expander.Header>
                            <TextBlock Text="Dictation" FontSize="15.5" FontWeight="SemiBold" Margin="2,2,0,2"/>
                        </Expander.Header>
                        <ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource SettingsNavItem}" Margin="0,4,0,0"
                                 SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="Dictation settings">
                            <ListBoxItem Content="General" Tag="General"/>
                            <ListBoxItem Content="Hotkeys" Tag="Hotkeys"/>
                            <ListBoxItem Content="Microphone" Tag="Audio"/>
                            <ListBoxItem Content="History" Tag="HistorySettings"/>
                        </ListBox>
                    </Expander>
                    <Expander x:Name="ModelsGroup" IsExpanded="True" Margin="0,0,0,10" Expanded="Group_Toggled" Collapsed="Group_Toggled">
                        <Expander.Header>
                            <TextBlock Text="Models &amp; AI" FontSize="15.5" FontWeight="SemiBold" Margin="2,2,0,2"/>
                        </Expander.Header>
                        <ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource SettingsNavItem}" Margin="0,4,0,0"
                                 SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="Models &amp; AI settings">
                            <ListBoxItem Content="Models" Tag="Models"/>
                            <ListBoxItem Content="Speech recognition" Tag="Speech"/>
                            <ListBoxItem Content="Cloud AI" Tag="Cloud"/>
                            <ListBoxItem Content="Model unloading" Tag="Unloading"/>
                        </ListBox>
                    </Expander>
                    <Expander x:Name="LookGroup" IsExpanded="True" Margin="0,0,0,10" Expanded="Group_Toggled" Collapsed="Group_Toggled">
                        <Expander.Header>
                            <TextBlock Text="Look &amp; feel" FontSize="15.5" FontWeight="SemiBold" Margin="2,2,0,2"/>
                        </Expander.Header>
                        <ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource SettingsNavItem}" Margin="0,4,0,0"
                                 SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="Look &amp; feel settings">
                            <ListBoxItem Content="Appearance" Tag="Appearance"/>
                        </ListBox>
                    </Expander>
                    <Expander x:Name="AppGroup" IsExpanded="True" Margin="0,0,0,10" Expanded="Group_Toggled" Collapsed="Group_Toggled">
                        <Expander.Header>
                            <TextBlock Text="App" FontSize="15.5" FontWeight="SemiBold" Margin="2,2,0,2"/>
                        </Expander.Header>
                        <ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource SettingsNavItem}" Margin="0,4,0,0"
                                 SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="App settings">
                            <ListBoxItem Content="Advanced" Tag="Advanced"/>
                            <ListBoxItem Content="About &amp; updates" Tag="About"/>
                        </ListBox>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ContentPresenter x:Name="Host" Grid.Column="1"/>
    </Grid>
</UserControl>
