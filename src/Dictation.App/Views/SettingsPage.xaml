<UserControl x:Class="Dictation.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings sections, grouped -->
        <Border BorderBrush="{DynamicResource Ob.Divider}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,30,14,16">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,14"/>
                    <ListBox x:Name="Nav" Style="{StaticResource NavList}" SelectionChanged="Nav_SelectionChanged"
                             AutomationProperties.Name="Settings sections">
                        <ListBoxItem Content="DICTATION" Style="{StaticResource NavGroupHeader}"/>
                        <ListBoxItem Content="General" Tag="General"/>
                        <ListBoxItem Content="Hotkeys" Tag="Hotkeys"/>
                        <ListBoxItem Content="Microphone" Tag="Audio"/>
                        <ListBoxItem Content="SPEECH &amp; AI" Style="{StaticResource NavGroupHeader}"/>
                        <ListBoxItem Content="Speech recognition" Tag="Speech"/>
                        <ListBoxItem Content="AI models" Tag="Models"/>
                        <ListBoxItem Content="Read aloud" Tag="ReadAloud"/>
                        <ListBoxItem Content="LOOK &amp; FEEL" Style="{StaticResource NavGroupHeader}"/>
                        <ListBoxItem Content="Appearance" Tag="Appearance"/>
                        <ListBoxItem Content="APP" Style="{StaticResource NavGroupHeader}"/>
                        <ListBoxItem Content="Advanced" Tag="Advanced"/>
                        <ListBoxItem Content="About &amp; updates" Tag="About"/>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ContentPresenter x:Name="Host" Grid.Column="1"/>
    </Grid>
</UserControl>
