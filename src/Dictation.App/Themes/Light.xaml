<!-- Oberton palette: light. Keys must match the other palette file; use them with DynamicResource so the theme can switch at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Ob.Window" Color="#F7F6F3"/> <!-- Page background -->
    <SolidColorBrush x:Key="Ob.Sidebar" Color="#EFEDE8"/> <!-- Sidebar background -->
    <SolidColorBrush x:Key="Ob.Card" Color="#FFFFFF"/> <!-- Cards and inputs -->
    <SolidColorBrush x:Key="Ob.Border" Color="#E0DCD4"/> <!-- Card and control outlines -->
    <SolidColorBrush x:Key="Ob.Divider" Color="#EAE7E0"/> <!-- Lines inside cards -->
    <SolidColorBrush x:Key="Ob.Text" Color="#1A1A1A"/> <!-- Body text -->
    <SolidColorBrush x:Key="Ob.Muted" Color="#5F5B54"/> <!-- Secondary text (4.5:1 on every background) -->
    <SolidColorBrush x:Key="Ob.Strong" Color="#161618"/> <!-- Primary buttons, checked switches, active chips -->
    <SolidColorBrush x:Key="Ob.OnStrong" Color="#FFFFFF"/> <!-- Text on Ob.Strong -->
    <SolidColorBrush x:Key="Ob.Subtle" Color="#E6E3DC"/> <!-- Status panel, slider tracks -->
    <SolidColorBrush x:Key="Ob.Hover" Color="#E6E3DC"/> <!-- Hovered list rows -->
    <SolidColorBrush x:Key="Ob.Selected" Color="#FFFFFF"/> <!-- Selected list rows -->
    <SolidColorBrush x:Key="Ob.Track" Color="#CFCAC0"/> <!-- Unchecked switch track -->
    <SolidColorBrush x:Key="Ob.Thumb" Color="#FFFFFF"/> <!-- Unchecked switch thumb -->
    <SolidColorBrush x:Key="Ob.Mark" Color="#161618"/> <!-- Background of the app mark -->
    <SolidColorBrush x:Key="Ob.Record" Color="#D9381E"/> <!-- The record light: the only accent color -->
    <SolidColorBrush x:Key="Ob.Ok" Color="#2F7D4F"/> <!-- Ready status -->
    <SolidColorBrush x:Key="Ob.Busy" Color="#B7791F"/> <!-- Starting / not ready status -->
    <SolidColorBrush x:Key="Ob.Error" Color="#B42318"/> <!-- Error text -->
    <SolidColorBrush x:Key="Ob.DiffRemoved" Color="#8A857C"/> <!-- Words the AI removed (struck through) -->
    <SolidColorBrush x:Key="Ob.DiffAdded" Color="#B3361C"/> <!-- Words the AI added -->
</ResourceDictionary>
