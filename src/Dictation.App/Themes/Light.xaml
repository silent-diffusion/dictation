<!-- Oberton palette: light. Ink on paper. Keys must match the other palette file; use them with DynamicResource so the
     theme can switch at runtime. The accent (Ob.Accent, and Ob.Busy / Ob.DiffAdded / Ob.Error, which follow it) is laid
     over this by ThemeManager from the chosen accent color. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Ob.Window" Color="#E8E7E3"/> <!-- Paper. Page background -->
    <SolidColorBrush x:Key="Ob.Sidebar" Color="#E8E7E3"/> <!-- Same paper; the sidebar is set off by a line, not a fill -->
    <SolidColorBrush x:Key="Ob.Card" Color="#E8E7E3"/> <!-- Paper behind quiet buttons and chips -->
    <SolidColorBrush x:Key="Ob.Border" Color="#0D0D0C"/> <!-- Ink lines: frames, capsule outlines, underlines -->
    <SolidColorBrush x:Key="Ob.Divider" Color="#380D0D0C"/> <!-- Hairlines between cells and rows -->
    <SolidColorBrush x:Key="Ob.Text" Color="#0D0D0C"/> <!-- Ink. Body text -->
    <SolidColorBrush x:Key="Ob.Muted" Color="#5C5B57"/> <!-- Secondary text and readouts (5:1 on paper) -->
    <SolidColorBrush x:Key="Ob.Strong" Color="#0D0D0C"/> <!-- Filled capsules, switches that are on, filled dots -->
    <SolidColorBrush x:Key="Ob.OnStrong" Color="#E8E7E3"/> <!-- Text on Ob.Strong -->
    <SolidColorBrush x:Key="Ob.Subtle" Color="#1A0D0D0C"/> <!-- Faint wash: previews, grids -->
    <SolidColorBrush x:Key="Ob.Hover" Color="#1A0D0D0C"/> <!-- Hovered rows and cells -->
    <SolidColorBrush x:Key="Ob.Selected" Color="#0D0D0C"/> <!-- The selected menu item: a filled ink capsule -->
    <SolidColorBrush x:Key="Ob.Track" Color="#5C5B57"/> <!-- Empty dots, switch outlines when off -->
    <SolidColorBrush x:Key="Ob.Thumb" Color="#5C5B57"/> <!-- Switch knob when off -->
    <SolidColorBrush x:Key="Ob.Mark" Color="#0D0D0C"/> <!-- The logo square -->
    <SolidColorBrush x:Key="Ob.MarkDot" Color="#E8E7E3"/> <!-- The logo's dot while idle (red while recording) -->
    <SolidColorBrush x:Key="Ob.Record" Color="#E3261A"/> <!-- Recording, and nothing else -->
    <SolidColorBrush x:Key="Ob.Accent" Color="#2340FF"/> <!-- What is live or matters most right now -->
    <SolidColorBrush x:Key="Ob.Ok" Color="#0D0D0C"/> <!-- Ready: a filled ink dot (the shape carries the state) -->
    <SolidColorBrush x:Key="Ob.Busy" Color="#2340FF"/> <!-- Starting or loading: live, so the accent -->
    <SolidColorBrush x:Key="Ob.Error" Color="#2340FF"/> <!-- Errors need attention first: the accent -->
    <SolidColorBrush x:Key="Ob.DiffRemoved" Color="#5C5B57"/> <!-- Words the AI removed (struck through) -->
    <SolidColorBrush x:Key="Ob.DiffAdded" Color="#2340FF"/> <!-- Words the AI added -->

    <!-- The Fluent controls' own accent (checkboxes, sliders, progress bars, focus lines): ink, so that color stays a
         signal. Ignored by any control that doesn't use these keys. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0D0D0C"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60D0D0C"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0D0D0C"/>
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#0D0D0C"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0D0D0C"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0D0D0C"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#5C5B57"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#E8E7E3"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E8E7E3"/>
</ResourceDictionary>
