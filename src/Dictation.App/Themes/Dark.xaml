<!-- Oberton palette: dark. The light sheet with ink and paper swapped. Keys must match the other palette file; use them
     with DynamicResource so the theme can switch at runtime. The accent is laid over this by ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Ob.Window" Color="#0E0E0D"/> <!-- Paper. Page background -->
    <SolidColorBrush x:Key="Ob.Sidebar" Color="#0E0E0D"/> <!-- Same paper; the sidebar is set off by a line, not a fill -->
    <SolidColorBrush x:Key="Ob.Card" Color="#0E0E0D"/> <!-- Paper behind quiet buttons and chips -->
    <SolidColorBrush x:Key="Ob.Border" Color="#E8E7E3"/> <!-- Ink lines: frames, capsule outlines, underlines -->
    <SolidColorBrush x:Key="Ob.Divider" Color="#3DE8E7E3"/> <!-- Hairlines between cells and rows -->
    <SolidColorBrush x:Key="Ob.Text" Color="#E8E7E3"/> <!-- Ink. Body text -->
    <SolidColorBrush x:Key="Ob.Muted" Color="#8F8D87"/> <!-- Secondary text and readouts (6:1 on paper) -->
    <SolidColorBrush x:Key="Ob.Strong" Color="#E8E7E3"/> <!-- Filled capsules, switches that are on, filled dots -->
    <SolidColorBrush x:Key="Ob.OnStrong" Color="#0E0E0D"/> <!-- Text on Ob.Strong -->
    <SolidColorBrush x:Key="Ob.Subtle" Color="#1AE8E7E3"/> <!-- Faint wash: previews, grids -->
    <SolidColorBrush x:Key="Ob.Hover" Color="#1AE8E7E3"/> <!-- Hovered rows and cells -->
    <SolidColorBrush x:Key="Ob.Selected" Color="#E8E7E3"/> <!-- The selected menu item: a filled ink capsule -->
    <SolidColorBrush x:Key="Ob.Track" Color="#8F8D87"/> <!-- Empty dots, switch outlines when off -->
    <SolidColorBrush x:Key="Ob.Thumb" Color="#8F8D87"/> <!-- Switch knob when off -->
    <SolidColorBrush x:Key="Ob.Mark" Color="#E8E7E3"/> <!-- The logo square -->
    <SolidColorBrush x:Key="Ob.MarkDot" Color="#0E0E0D"/> <!-- The logo's dot while idle (red while recording) -->
    <SolidColorBrush x:Key="Ob.Record" Color="#FF4636"/> <!-- Recording, and nothing else -->
    <SolidColorBrush x:Key="Ob.Accent" Color="#7F8DFF"/> <!-- What is live or matters most right now -->
    <SolidColorBrush x:Key="Ob.Ok" Color="#E8E7E3"/> <!-- Ready: a filled ink dot (the shape carries the state) -->
    <SolidColorBrush x:Key="Ob.Busy" Color="#7F8DFF"/> <!-- Starting or loading: live, so the accent -->
    <SolidColorBrush x:Key="Ob.Error" Color="#7F8DFF"/> <!-- Errors need attention first: the accent -->
    <SolidColorBrush x:Key="Ob.DiffRemoved" Color="#8F8D87"/> <!-- Words the AI removed (struck through) -->
    <SolidColorBrush x:Key="Ob.DiffAdded" Color="#7F8DFF"/> <!-- Words the AI added -->

    <!-- The Fluent controls' own accent (checkboxes, sliders, progress bars, focus lines): ink, so that color stays a
         signal. Ignored by any control that doesn't use these keys. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E8E7E3"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6E8E7E3"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCE8E7E3"/>
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#E8E7E3"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E8E7E3"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E8E7E3"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8F8D87"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0E0E0D"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#0E0E0D"/>
</ResourceDictionary>
